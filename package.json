{
  "name": "flycodecenter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node ./scripts/dev-server.mjs",
    "dev:sync": "node ./scripts/dev-server.mjs --sync-content",
    "dev:astro": "astro dev",
    "sync:articles": "node ./scripts/fix-frontmatter-normalization.mjs",
    "fix:frontmatter": "node ./scripts/fix-frontmatter-normalization.mjs",
    "lint:frontmatter": "tsx ./scripts/lint-frontmatter-tags.mjs",
    "rebuild:frontmatter": "node ./scripts/rebuild-frontmatter.mjs",
    "guard:quality": "node ./scripts/quality-guard.mjs",
    "clean:astro": "node ./scripts/clean-astro-cache.mjs --all",
    "prebuild": "node ./scripts/clean-astro-cache.mjs",
    "build": "npm run sync:articles && npm run guard:quality && npm run build:minisearch && npm run encrypt && astro build",
    "preview": "astro preview",
    "postbuild": "node ./scripts/pagefind-index.mjs",
    "build:minisearch": "node ./scripts/build-minisearch.mjs",
    "build:pagefind": "node ./scripts/pagefind-index.mjs",
    "encrypt": "node ./scripts/encrypt.mjs",
    "test:e2e": "npm run build:minisearch && playwright test",
    "test:e2e:chromium": "npm run build:minisearch && playwright test --project=chromium-desktop --project=mobile-chromium",
    "test:e2e:performance": "npm run build:minisearch && playwright test --config=playwright.performance.config.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.5",
    "@shikijs/transformers": "^3.13.0",
    "@shikijs/twoslash": "^3.13.0",
    "algoliasearch": "^5.41.0",
    "astro": "^7.2.0",
    "astro-expressive-code": "^0.44.1",
    "gray-matter": "^4.0.3",
    "marked": "^16.4.2",
    "mdast-util-from-markdown": "^2.0.2",
    "mermaid": "^11.16.1",
    "micromatch": "^4.0.8",
    "minisearch": "^7.2.0",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^24.6.2",
    "pagefind": "^1.4.0",
    "tsx": "^4.23.11"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  }
}
