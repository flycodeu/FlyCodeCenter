---
interface Props {
  title: string;
  image?: string;
  alt?: string;
  kindLabel?: string;
  topic?: string;
  srcset?: string;
  sizes?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  variant?: "compact" | "regular" | "large";
}

const {
  title,
  image = "",
  alt = title,
  kindLabel = "文章",
  topic = "",
  srcset,
  sizes,
  loading = "lazy",
  fetchpriority = "low",
  variant = "regular"
} = Astro.props;

const normalizedTitle = String(title || "").trim() || "未命名内容";
const normalizedImage = String(image || "").trim();
const normalizedTopic = String(topic || "").trim();
const mark = Array.from(normalizedTitle)[0]?.toUpperCase() || "文";
const eyebrow = [kindLabel, normalizedTopic].filter(Boolean).join(" · ");

let titleHash = 0;
for (let i = 0; i < normalizedTitle.length; i++) {
  titleHash = normalizedTitle.charCodeAt(i) + ((titleHash << 5) - titleHash);
}
const coverHue = Math.abs(titleHash) % 360;
---

<span
  class={`content-cover variant-${variant}`}
  data-content-cover
  data-image-state={normalizedImage ? "loading" : "fallback"}
>
  <span class="content-cover-fallback" aria-hidden="true" style={`--cover-hue: ${coverHue};`}>
    <span class="content-cover-copy">
      <span class="content-cover-eyebrow">{eyebrow}</span>
      <strong class="content-cover-title">{normalizedTitle}</strong>
    </span>
    <span class="content-cover-mark">{mark}</span>
  </span>

  {
    normalizedImage && (
      <img
        src={normalizedImage}
        srcset={srcset}
        sizes={sizes}
        alt={alt}
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
        referrerpolicy="no-referrer"
        onload="this.closest('[data-content-cover]')?.setAttribute('data-image-state','loaded')"
        onerror="this.hidden=true;this.closest('[data-content-cover]')?.setAttribute('data-image-state','error')"
      />
    )
  }
</span>

<style>
  .content-cover {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-height: 140px;
    min-width: 0;
    overflow: hidden;
    isolation: isolate;
    background: color-mix(in oklab, var(--surface-2) 76%, var(--brand-soft) 24%);
  }

  .content-cover-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 1rem 1.25rem;
    overflow: hidden;
    background:
      radial-gradient(130% 130% at 50% 30%, color-mix(in oklab, hsl(var(--cover-hue) 60% 50%) 16%, transparent 84%) 0%, transparent 70%),
      linear-gradient(145deg, color-mix(in oklab, var(--surface-1) 85%, var(--surface-2) 15%) 0%, var(--surface-2) 100%);
    border: 1px solid color-mix(in oklab, var(--line) 75%, transparent 25%);
  }

  .content-cover-fallback::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(color-mix(in oklab, var(--line) 45%, transparent 55%) 1px, transparent 1px);
    background-size: 14px 14px;
    opacity: 0.35;
    pointer-events: none;
  }

  .content-cover-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    max-width: 92%;
  }

  .content-cover-eyebrow {
    color: var(--brand);
    font-family: var(--font-tech);
    font-size: 0.7rem;
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: color-mix(in oklab, var(--brand-soft) 45%, var(--surface-1) 55%);
    padding: 0.12rem 0.55rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--brand) 22%, transparent 78%);
  }

  .content-cover-title {
    width: 100%;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 650;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
    text-align: center;
  }

  .content-cover-mark {
    display: block;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: 5rem;
    font-weight: 900;
    font-family: var(--font-tech);
    color: color-mix(in oklab, var(--text) 5%, transparent 95%);
    line-height: 1;
    pointer-events: none;
    user-select: none;
    letter-spacing: -0.05em;
    z-index: 1;
  }

  .content-cover img {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 180ms ease, transform 240ms ease;
  }

  .content-cover[data-image-state="loaded"] img {
    opacity: 1;
  }

  .content-cover:hover img {
    transform: scale(1.03);
  }

  .variant-compact .content-cover-fallback {
    padding: 0.62rem 0.66rem;
  }

  .variant-compact .content-cover-eyebrow {
    font-size: 0.62rem;
  }

  .variant-compact .content-cover-title {
    font-size: 0.8rem;
    line-height: 1.28;
  }

  .variant-compact .content-cover-mark {
    font-size: 3.7rem;
  }

  .variant-large .content-cover-fallback {
    padding: 1rem 1.05rem;
  }

  .variant-large .content-cover-title {
    max-width: 76%;
    font-size: 1.08rem;
  }

  .variant-large .content-cover-mark {
    font-size: 6.4rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .content-cover img {
      transition: none;
    }
  }

  @media (hover: none) {
    .content-cover:hover img {
      transform: none;
    }
  }
</style>
