---
import siteConfig from "@/site.config";

const pathname = Astro.url.pathname;
const interviewConfig = siteConfig.pages.interviewCenter;

type NavItem = { text: string; link: string };

const mainItems: NavItem[] = [...siteConfig.theme.navbar];
const moreItems: NavItem[] = [
  ...(((siteConfig.theme as { navbarMore?: readonly NavItem[] }).navbarMore ?? []) as NavItem[])
];

if (interviewConfig.enable) {
  moreItems.push({ text: interviewConfig.navLabel, link: interviewConfig.route });
}

const isActive = (link: string) => pathname === link || (link !== "/" && pathname.startsWith(`${link}/`));
const moreActive = moreItems.some((item) => isActive(item.link));
---

<nav class="nav">
  {
    mainItems.map((item) => (
      <a
        class={`nav-link ${isActive(item.link) ? "active" : ""}`}
        href={item.link}
        aria-current={isActive(item.link) ? "page" : undefined}
      >
        {item.text}
      </a>
    ))
  }

  {moreItems.length > 0 && (
    <details class={`nav-more ${moreActive ? "is-active" : ""}`} data-nav-more>
      <summary class={`nav-link nav-more-btn ${moreActive ? "active" : ""}`}>
        更多
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <div class="nav-more-menu">
        {moreItems.map((item) => (
          <a
            class={`nav-more-link ${isActive(item.link) ? "active" : ""}`}
            href={item.link}
            aria-current={isActive(item.link) ? "page" : undefined}
          >
            {item.text}
          </a>
        ))}
      </div>
    </details>
  )}

  {moreItems.map((item) => (
    <a
      class={`nav-link nav-inline-more ${isActive(item.link) ? "active" : ""}`}
      href={item.link}
      aria-current={isActive(item.link) ? "page" : undefined}
    >
      {item.text}
    </a>
  ))}
</nav>

<script is:inline>
  (() => {
    const state = window.__flyNavState ?? { bound: false };
    window.__flyNavState = state;

    const closeAll = (except) => {
      document.querySelectorAll("details[data-nav-more][open]").forEach((el) => {
        if (el !== except) el.removeAttribute("open");
      });
    };

    if (!state.bound) {
      state.bound = true;
      document.addEventListener("click", (event) => {
        const target =
          event.target instanceof Element
            ? event.target
            : event.target instanceof Node
              ? event.target.parentElement
              : null;
        const owner = target?.closest("details[data-nav-more]");
        const summary = target?.closest("summary");

        if (owner instanceof HTMLDetailsElement && summary?.parentElement === owner) {
          event.preventDefault();
          const shouldOpen = !owner.open;
          closeAll(owner);
          owner.open = shouldOpen;
          return;
        }

        if (owner && target?.closest("a")) {
          closeAll(null);
          return;
        }
        closeAll(owner);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeAll(null);
      });
      document.addEventListener("astro:before-swap", () => closeAll(null));
    }

    closeAll(null);
  })();
</script>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: 0.18rem;
    min-width: 0;
  }

  :global(.nav-link) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.28rem;
    min-height: 38px;
    padding: 0.38rem 0.76rem;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-soft);
    white-space: nowrap;
    font-size: 0.82rem;
    font-weight: 520;
    letter-spacing: 0.01em;
    transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease;
    flex: 0 0 auto;
    cursor: pointer;
  }

  :global(.nav-link:hover) {
    color: var(--text);
    background: color-mix(in oklab, var(--line) 20%, transparent 80%);
    border-color: transparent;
    transform: none;
    box-shadow: none;
  }

  :global(.nav-link.active) {
    color: var(--brand);
    background: transparent;
    border-color: transparent;
    box-shadow: none;
    font-weight: 600;
  }

  .nav-more {
    position: relative;
    flex: 0 0 auto;
  }

  .nav-more-btn {
    list-style: none;
    user-select: none;
  }

  .nav-more-btn::-webkit-details-marker {
    display: none;
  }

  .nav-more-btn svg {
    transition: transform 160ms ease;
  }

  .nav-more[open] .nav-more-btn svg {
    transform: rotate(180deg);
  }

  .nav-more-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 80;
    min-width: 148px;
    display: grid;
    gap: 2px;
    padding: 6px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--bg-elev);
    box-shadow: var(--card-shadow-strong);
  }

  .nav-more-link {
    display: block;
    padding: 0.46rem 0.72rem;
    border-radius: 9px;
    color: var(--text-soft);
    font-size: 0.84rem;
    white-space: nowrap;
  }

  .nav-more-link:hover {
    color: var(--text);
    background: color-mix(in oklab, var(--brand-soft) 40%, transparent 60%);
  }

  .nav-more-link.active {
    color: var(--brand);
    font-weight: 600;
  }

  .nav-inline-more {
    display: none;
  }

  @media (max-width: 900px) {
    .nav {
      width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 0.08rem;
    }

    .nav::-webkit-scrollbar {
      display: none;
    }

    .nav-more {
      display: none;
    }

    .nav-inline-more {
      display: inline-flex;
    }

    :global(.nav-link) {
      min-height: 40px;
      padding: 0.46rem 0.82rem;
    }
  }
</style>
