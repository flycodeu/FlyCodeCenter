---
import siteConfig from "@/site.config";

interface MascotConfig {
  enable?: boolean;
  defaultOpen?: boolean;
  position?: "bottom-right" | "bottom-left";
  defaultModel?: "rem";
  enableDialogue?: boolean;
  allowDrag?: boolean;
}

const config = ((siteConfig.ui as { mascot?: MascotConfig } | undefined)?.mascot) ?? {};
const enabled = config.enable ?? true;
const defaultOpen = config.defaultOpen ?? true;
const defaultPosition = config.position ?? "bottom-right";
const defaultModel = config.defaultModel ?? "rem";
const enableDialogue = config.enableDialogue ?? true;
const allowDrag = config.allowDrag ?? true;
---

{
  enabled && (
    <>
      <!-- AI 独立对话弹窗及遮罩 (居中大尺寸真实陪伴聊天界面) -->
      <div id="mascot-ai-backdrop" class="mascot-ai-backdrop" hidden transition:persist="mascot-ai-backdrop"></div>
      <div
        id="mascot-ai-box"
        class="mascot-ai-box"
        role="dialog"
        aria-modal="true"
        aria-label="雷姆伴聊"
        hidden
        transition:persist="mascot-ai-box"
      >
        <!-- 顶部身份信息栏 -->
        <header id="mascot-ai-head" class="ai-box-head">
          <div class="ai-head-user">
            <div class="ai-head-avatar">
              <img src="/live2d/rem/avatar.png" alt="雷姆" width="40" height="40" />
              <span class="status-indicator" title="在线"></span>
            </div>
            <div class="ai-head-meta">
              <div class="ai-head-name">
                <strong>雷姆 (Rem)</strong>
                <span class="ai-head-badge">在线看板娘</span>
              </div>
              <span class="ai-head-status">随时倾听主人的吩咐与交流</span>
            </div>
          </div>
          <div class="ai-head-actions">
            <button
              type="button"
              id="mascot-ai-clear"
              class="ai-head-btn"
              title="清空对话记录"
              aria-label="清空对话"
            >
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 6h18" />
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
              </svg>
              <span>清空</span>
            </button>
            <button
              type="button"
              id="mascot-ai-close"
              class="ai-head-btn close-btn"
              title="关闭 (Esc)"
              aria-label="关闭对话面板"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </header>

        <!-- 聊天记录滚动区域 -->
        <div id="mascot-ai-msgs" class="ai-box-msgs" tabindex="0" role="log" aria-live="polite">
          <!-- 默认欢迎消息行 -->
          <div class="chat-row is-bot">
            <div class="chat-avatar bot-avatar">
              <img src="/live2d/rem/avatar.png" alt="雷姆" width="40" height="40" />
            </div>
            <div class="chat-body">
              <div class="chat-meta">
                <span class="chat-name">雷姆</span>
                <span class="chat-time">在线</span>
              </div>
              <div class="chat-bubble bot-bubble">
                <p>主人好呀！我是雷姆~ 今天写代码还顺利吗？无论是遇到工程架构难题、技术选型，还是想闭目休息聊聊天，雷姆都会一直陪在您身边哦~</p>
              </div>
            </div>
          </div>
        </div>

        <!-- 底部专业输入表单 -->
        <form id="mascot-ai-form" class="ai-box-form">
          <div class="input-container">
            <textarea
              id="mascot-ai-input"
              class="ai-box-textarea"
              rows="2"
              placeholder="陪雷姆聊聊天，或者输入技术疑问与代码交流... (Enter 发送，Shift + Enter 换行)"
              maxlength="500"
            ></textarea>
            <div class="input-actions-bar">
              <span class="input-tip">Enter 发送 · Shift+Enter 换行</span>
              <button type="submit" id="mascot-ai-submit" class="ai-send-btn" title="发送 (Enter)">
                <span>发送</span>
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="22" y1="2" x2="11" y2="13" />
                  <polygon points="22 2 15 22 11 13 2 9 22 2" />
                </svg>
              </button>
            </div>
          </div>
        </form>
      </div>

      <!-- 看板娘主形象与快捷工具 -->
      <div
        id="fly-mascot-root"
        class={`fly-mascot-container pos-${defaultPosition}`}
        data-default-open={defaultOpen ? "1" : "0"}
        data-default-model={defaultModel}
        data-enable-dialogue={enableDialogue ? "1" : "0"}
        data-allow-drag={allowDrag ? "1" : "0"}
        style="display: none;"
        transition:persist="fly-mascot-root"
      >
        <aside
          id="fly-mascot-widget"
          class="mascot-widget"
          role="complementary"
          aria-label="雷姆看板娘"
        >
          <!-- 趣味对话文字聊天气泡 -->
          <div id="mascot-bubble" class="mascot-bubble" aria-live="polite">
            <span id="mascot-bubble-text" class="bubble-text">主人好呀！我是雷姆，随时为您待命~</span>
            <button type="button" id="mascot-bubble-close" class="bubble-close-btn" title="关闭对话" aria-label="关闭气泡对话">×</button>
          </div>

          <!-- 悬停快捷操作栏 -->
          <nav class="mascot-toolbar" aria-label="看板娘快捷工具">
            <button type="button" class="toolbar-btn ai-btn" data-action="ai" title="AI 智能问答" aria-label="AI 智能问答">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="10" rx="2" />
                <circle cx="12" cy="5" r="2" />
                <path d="M12 7v4" />
                <line x1="8" y1="16" x2="8.01" y2="16" stroke-width="3" />
                <line x1="16" y1="16" x2="16.01" y2="16" stroke-width="3" />
              </svg>
            </button>
            <button type="button" class="toolbar-btn" data-action="talk" title="日常对话" aria-label="日常对话">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
              </svg>
            </button>
            <button type="button" class="toolbar-btn" data-action="motion" title="角色互动" aria-label="角色互动">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3" />
              </svg>
            </button>
            <button type="button" class="toolbar-btn particle-btn" data-action="particles" title="唯美樱花与冰晶微光 (开/关)" aria-label="动效开关">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
              </svg>
            </button>
            <button type="button" class="toolbar-btn" data-action="top" title="回到顶部" aria-label="回到顶部">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 15l-6-6-6 6" />
                <path d="M6 5h12" />
              </svg>
            </button>
            <button type="button" class="toolbar-btn close-btn" data-action="close" title="收起看板娘" aria-label="收起看板娘">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 6L6 18M6 6l12 12" />
              </svg>
            </button>
          </nav>

          <!-- 看板娘主形象 (高清 Live2D Canvas，放大画幅至 500x760 超清呈现) -->
          <div id="mascot-character" class="mascot-character" title="雷姆">
            <canvas
              id="live2d-canvas"
              class="live2d-canvas"
              width="500"
              height="760"
            ></canvas>
          </div>

          <!-- 角色底座微光光晕 (贴底自然承托，彻底消除悬空截断感) -->
          <div class="mascot-pedestal" aria-hidden="true"></div>
        </aside>

        <!-- 唤醒/召唤浮动胶囊 -->
        <button
          type="button"
          id="mascot-summoner-btn"
          class="mascot-summoner-btn"
          title="唤醒雷姆"
          aria-label="唤醒雷姆"
          style="display: none;"
        >
          <span class="summon-badge-icon" aria-hidden="true">🌸</span>
          <span id="mascot-summon-name" class="summon-badge-text">雷姆</span>
        </button>
      </div>
    </>
  )
}

<style is:global>
  /* 全局容器定位 */
  .fly-mascot-container {
    position: fixed;
    z-index: 85;
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .fly-mascot-container.pos-bottom-right {
    right: -24px;
    bottom: -46px;
  }

  .fly-mascot-container.pos-bottom-left {
    left: -24px;
    bottom: -46px;
  }

  /* 角色底部微光地台光晕 (消除悬空突兀感，优雅承托) */
  .mascot-pedestal {
    position: absolute;
    bottom: 46px;
    left: 50%;
    transform: translateX(-50%);
    width: 170px;
    height: 16px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, color-mix(in oklab, var(--brand) 45%, transparent 55%) 0%, color-mix(in oklab, var(--brand) 16%, transparent 84%) 50%, transparent 80%);
    box-shadow: 0 4px 18px color-mix(in oklab, var(--brand) 32%, transparent 68%);
    pointer-events: none;
    z-index: 1;
    filter: blur(2px);
  }

  /* 主体挂件容器 (进一步放大至 250x380px，修长灵动，二次元美少女细节大幅增强) */
  .mascot-widget {
    position: relative;
    width: 250px;
    height: 380px;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: auto;
    touch-action: none;
    opacity: 0.98;
    filter: drop-shadow(0 12px 32px rgba(0, 0, 0, 0.22));
    transition: opacity 0.24s ease, transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .mascot-widget:hover {
    opacity: 1;
    filter: drop-shadow(0 16px 40px rgba(0, 0, 0, 0.3));
  }

  .mascot-widget.is-dragging {
    opacity: 0.96;
    transform: scale(1.03);
    cursor: grabbing !important;
    filter: drop-shadow(0 16px 36px color-mix(in oklab, var(--brand) 38%, transparent 62%));
    transition: none !important;
  }

  .mascot-widget.is-closing {
    opacity: 0;
    transform: scale(0.4) translateY(50px);
    pointer-events: none;
  }

  /* 角色画布交互区域 */
  .mascot-character {
    position: relative;
    width: 100%;
    height: 100%;
    cursor: grab;
    transform-origin: center bottom;
  }

  .mascot-character:active {
    cursor: grabbing;
  }

  .live2d-canvas {
    width: 250px;
    height: 380px;
    display: block;
    pointer-events: none;
    opacity: 1;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 78%, rgba(0, 0, 0, 0.75) 83%, rgba(0, 0, 0, 0.2) 85.5%, transparent 86.8%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 78%, rgba(0, 0, 0, 0.75) 83%, rgba(0, 0, 0, 0.2) 85.5%, transparent 86.8%);
  }

  /* 顶部浮动快捷操作栏 (高度优化贴近角色头部，内置交互安全桥，移动绝不丢失) */
  .mascot-toolbar {
    position: absolute;
    top: -12px; /* 降低高度：紧贴角色头部上方，彻底消除悬空断层 */
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 4px 9px;
    background: color-mix(in oklab, var(--surface-1) 94%, transparent 6%);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid color-mix(in oklab, var(--line) 80%, transparent 20%);
    border-radius: 999px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.14);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease 0.16s, transform 0.22s ease 0.16s;
    z-index: 30; /* 确保操作栏在最清晰的高层级，绝不被任何气泡阻挡 */
  }

  /* 鼠标交互防丢失安全桥 (Hover Bridge)：向下覆盖至角色头部，鼠标在角色与操作栏间移动绝不丢失 hover */
  .mascot-toolbar::before {
    content: "";
    position: absolute;
    inset: -8px -12px -24px -12px;
    z-index: -1;
  }

  .mascot-widget:hover .mascot-toolbar,
  .mascot-widget:focus-within .mascot-toolbar,
  .mascot-toolbar:hover {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
    transition-delay: 0s; /* 移入立即展现 */
  }

  /* 当 AI 面板打开时，气泡隐藏，避免与 AI 对话重叠冲突 */
  .mascot-widget.ai-open .mascot-bubble {
    display: none !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .toolbar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--text-soft, #64748b);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
    padding: 0;
  }

  .toolbar-btn:hover {
    background: color-mix(in oklab, var(--surface-2) 90%, transparent 10%);
    color: var(--brand);
    transform: scale(1.14);
  }

  .toolbar-btn.ai-btn:hover {
    color: #06b6d4;
    background: color-mix(in oklab, #06b6d4 15%, transparent 85%);
  }

  .toolbar-btn.particle-btn:hover {
    color: #f43f5e;
    background: color-mix(in oklab, #f43f5e 15%, transparent 85%);
  }

  .toolbar-btn.close-btn:hover {
    color: #ef4444;
  }

  /* 趣味对话文字聊天气泡：移至角色左侧偏上，彻底与顶部操作栏错开，绝不覆盖操作栏 */
  .mascot-bubble {
    position: absolute;
    right: calc(100% + 14px);
    top: 20px;
    width: max-content;
    max-width: 210px;
    padding: 9px 13px;
    background: color-mix(in oklab, var(--surface-1) 96%, transparent 4%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid color-mix(in oklab, var(--line) 85%, transparent 15%);
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
    display: flex;
    align-items: flex-start;
    gap: 6px;
    opacity: 0;
    transform: scale(0.88) translateX(10px);
    pointer-events: none;
    transition: opacity 0.22s ease, transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 25;
  }

  .mascot-bubble.is-visible {
    opacity: 1;
    transform: scale(1) translateX(0);
    pointer-events: auto;
  }

  /* 指向右侧角色的三角箭头 */
  .mascot-bubble::after {
    content: "";
    position: absolute;
    right: -6px;
    top: 14px;
    width: 10px;
    height: 10px;
    background: var(--surface-1);
    border-top: 1px solid color-mix(in oklab, var(--line) 85%, transparent 15%);
    border-right: 1px solid color-mix(in oklab, var(--line) 85%, transparent 15%);
    transform: rotate(45deg);
  }

  /* 角色若处于屏幕左侧，气泡自动镜像在右侧 */
  .mascot-widget.flip-left .mascot-bubble {
    right: auto;
    left: calc(100% + 14px);
    transform: scale(0.88) translateX(-10px);
  }

  .mascot-widget.flip-left .mascot-bubble.is-visible {
    transform: scale(1) translateX(0);
  }

  .mascot-widget.flip-left .mascot-bubble::after {
    right: auto;
    left: -6px;
    border-top: none;
    border-right: none;
    border-bottom: 1px solid color-mix(in oklab, var(--line) 85%, transparent 15%);
    border-left: 1px solid color-mix(in oklab, var(--line) 85%, transparent 15%);
    transform: rotate(45deg);
  }

  .bubble-text {
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--text);
    word-break: break-word;
  }

  .bubble-close-btn {
    border: none;
    background: transparent;
    color: var(--text-soft, #94a3b8);
    font-size: 0.85rem;
    line-height: 1;
    padding: 0;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.15s ease;
  }

  .bubble-close-btn:hover {
    opacity: 1;
    color: var(--text);
  }

  /* 独立背景遮罩 (支持轻度暗化与高质感毛玻璃，专注对话) */
  .mascot-ai-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(10, 15, 28, 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 95;
    pointer-events: auto;
    animation: mascot-fade-in 0.18s ease;
  }

  .mascot-ai-backdrop.is-open {
    display: block;
  }

  .mascot-ai-backdrop[hidden] {
    display: none !important;
  }

  @keyframes mascot-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* AI 智能对话独立面板 (屏幕居中大尺寸，真实陪伴聊天窗口，高级毛玻璃与柔光二次元质感) */
  .mascot-ai-box {
    display: none !important;
    position: fixed !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
    width: min(800px, calc(100vw - 36px)) !important;
    height: min(720px, calc(100vh - 48px)) !important;
    max-height: min(760px, calc(100vh - 36px));
    flex-direction: column;
    background: color-mix(in oklab, var(--surface-1) 85%, transparent 15%);
    backdrop-filter: blur(28px) saturate(140%);
    -webkit-backdrop-filter: blur(28px) saturate(140%);
    border: 1px solid color-mix(in oklab, var(--line) 75%, transparent 25%);
    border-radius: 24px;
    box-shadow:
      0 32px 80px -16px rgba(0, 0, 0, 0.45),
      0 0 0 1px color-mix(in oklab, #38bdf8 26%, transparent 74%),
      0 0 45px -10px color-mix(in oklab, #38bdf8 18%, transparent 82%);
    overflow: hidden;
    overscroll-behavior: contain !important;
    z-index: 96;
    pointer-events: auto;
  }

  .mascot-ai-box.is-open {
    display: flex !important;
    animation: mascot-box-center-in 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mascot-ai-box[hidden] {
    display: none !important;
  }

  @keyframes mascot-box-center-in {
    0% {
      opacity: 0;
      transform: translate(-50%, -46%) scale(0.96);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  /* 顶部身份栏 */
  .ai-box-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    background: color-mix(in oklab, var(--surface-2) 80%, transparent 20%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid color-mix(in oklab, var(--line) 70%, transparent 30%);
    flex-shrink: 0;
    user-select: none;
    -webkit-user-select: none;
  }

  .ai-head-user {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-head-avatar {
    position: relative;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    border: 1.5px solid var(--line);
    background: var(--surface-1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-head-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .status-indicator {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #22c55e;
    border: 2px solid var(--surface-2);
  }

  .ai-head-meta {
    display: flex;
