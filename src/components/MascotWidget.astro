  // 动态载入本地 Live2D 运行时脚本 (不阻塞主线程首屏渲染)
  function ensureLive2DScript(): Promise<void> {
    return new Promise((resolve, reject) => {
      if (typeof (window as any).loadlive2d === "function") {
        resolve();
        return;
      }
      const existing = document.querySelector("script[data-live2d-script]");
      if (existing) {
        existing.addEventListener("load", () => resolve());
        existing.addEventListener("error", (e) => reject(e));
        return;
      }
      const script = document.createElement("script");
      script.src = "/vendor/live2d.min.js";
      script.async = true;
      script.dataset.live2dScript = "1";
      script.onload = () => resolve();
      script.onerror = (e) => reject(e);
      document.head.appendChild(script);
    });
  }

  // 触发 Live2D 原生轻量动作播放
  function playMascotMotion(group: "flick_head" | "tap_body" | "talk" | "idle", priority = 3) {
    try {
      const app = (window as any).live2dApp;
      if (app?.models?.[0] && typeof app.models[0].startRandomMotion === "function") {
        app.models[0].startRandomMotion(group, priority);
      }
    } catch (err) {
      console.debug("[Live2D] Motion error:", err);
    }
  }

  function initMascot() {
    const root = document.getElementById("fly-mascot-root");
    if (!root) return;
    if ((root as any).__mascotInited) return;
    (root as any).__mascotInited = true;

    const widget = document.getElementById("fly-mascot-widget");
    const character = document.getElementById("mascot-character");
    const summonerBtn = document.getElementById("mascot-summoner-btn");
    const summonName = document.getElementById("mascot-summon-name");
    const bubble = document.getElementById("mascot-bubble");
    const bubbleText = document.getElementById("mascot-bubble-text");
    const bubbleClose = document.getElementById("mascot-bubble-close");
    const canvas = document.getElementById("live2d-canvas") as HTMLCanvasElement | null;

    // AI 独立对话弹窗及遮罩元素
    const aiBackdrop = document.getElementById("mascot-ai-backdrop");
    const aiBox = document.getElementById("mascot-ai-box");
    const aiClose = document.getElementById("mascot-ai-close");
    const aiMsgs = document.getElementById("mascot-ai-msgs");
    const aiClear = document.getElementById("mascot-ai-clear");
    const aiForm = document.getElementById("mascot-ai-form") as HTMLFormElement | null;
    const aiInput = document.getElementById("mascot-ai-input") as HTMLTextAreaElement | null;

    if (!widget || !character || !summonerBtn || !canvas) return;

    // 显示根容器
    root.style.display = "block";

    // 本地存储 Keys
    const STORAGE_KEY_CLOSED = "fly_mascot_closed";
    const STORAGE_KEY_POS = "fly_mascot_pos";

    const isMobile = window.innerWidth <= 768;
    const defaultOpen = root.dataset.defaultOpen === "1";
    const savedClosed = localStorage.getItem(STORAGE_KEY_CLOSED);

    // 移动端默认折叠，桌面端依据设置与缓存
    let isClosed = savedClosed !== null ? savedClosed === "1" : (isMobile || !defaultOpen);

    // 更新唤醒按钮名字为雷姆
    if (summonName) {
      summonName.textContent = "雷姆";
    }

    // 恢复位置（如有保存）
    restorePosition();
    if (root.classList.contains("pos-bottom-left") && !localStorage.getItem(STORAGE_KEY_POS)) {
      updateFlipState(20);
    }

    // 同步展示状态
    syncDisplayState(false);

    // 加载雷姆 Live2D 动漫模型
    loadCurrentModel();

    function loadCurrentModel() {
      ensureLive2DScript()
        .then(() => {
          const loadlive2d = (window as any).loadlive2d;
          if (typeof loadlive2d !== "function") return;

          try {
            loadlive2d("live2d-canvas", REM_MODEL.url);
          } catch (err) {
            console.warn("[Live2D] load error:", err);
          }
        })
        .catch((err) => {
          console.warn("[Live2D] Failed to load local runtime script:", err);
        });
    }

    // 1. 看板娘拖拽移动与部位点击交互判别 (摸头 / 戳身体 / 拖拽防飞出)
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let initialLeft = 0;
    let initialTop = 0;
    let hasMoved = false;
    let pointerDownTargetY = 0;

    // 角色两侧具有约 44px 的透明画幅留白，底部有 46px 留白。
    // 允许留白区微量溢出，消除右侧生硬间隙，使雷姆本体可以紧贴视口右边缘
    const BLEED_X = 44;
    const BLEED_BOTTOM = 46;

    function clampPosition(x: number, y: number) {
      const wWidth = window.innerWidth;
      const wHeight = window.innerHeight;
      const rect = widget.getBoundingClientRect();
      const minX = -BLEED_X;
      const maxX = wWidth - rect.width + BLEED_X;
      const minY = 8;
      const maxY = wHeight - rect.height + BLEED_BOTTOM;
      const clampedX = Math.max(minX, Math.min(maxX, x));
      const clampedY = Math.max(minY, Math.min(maxY, y));
      return { x: clampedX, y: clampedY };
    }

    function onPointerDown(e: PointerEvent) {
      // 避免工具栏、气泡或 AI 浮窗内点击触发角色拖拽
      if ((e.target as HTMLElement)?.closest(".mascot-toolbar, .mascot-bubble, .mascot-ai-box")) return;

      isDragging = true;
      hasMoved = false;
      startX = e.clientX;
      startY = e.clientY;

      const rect = widget.getBoundingClientRect();
      initialLeft = rect.left;
      initialTop = rect.top;

      // 记录点击在角色 Y 轴的相对百分比
      pointerDownTargetY = (e.clientY - rect.top) / rect.height;

      character.setPointerCapture(e.pointerId);
    }

    function onPointerMove(e: PointerEvent) {
      if (!isDragging) return;

      const deltaX = e.clientX - startX;
      const deltaY = e.clientY - startY;

      if (!hasMoved && Math.hypot(deltaX, deltaY) > 5) {
        hasMoved = true;
        widget.classList.add("is-dragging");
        hideBubble();
        closeAiBox();
      }

      if (hasMoved) {
        const rawX = initialLeft + deltaX;
        const rawY = initialTop + deltaY;
        const clamped = clampPosition(rawX, rawY);

        root.style.left = `${clamped.x}px`;
        root.style.top = `${clamped.y}px`;
        root.style.right = "auto";
        root.style.bottom = "auto";
        updateFlipState(clamped.x);
      }
    }

    function onPointerUp(e: PointerEvent) {
      if (!isDragging) return;
      isDragging = false;
      try {
        character.releasePointerCapture(e.pointerId);
      } catch {}

      widget.classList.remove("is-dragging");

      if (hasMoved) {
        // 用户拖拽到哪就绝对固定在哪，严禁任何自动平移、弹跳或重新计算
        const curX = parseFloat(root.style.left) || 0;
        const curY = parseFloat(root.style.top) || 0;

        localStorage.setItem(
          STORAGE_KEY_POS,
          JSON.stringify({
            x: curX,
            y: curY,
            vw: window.innerWidth,
            vh: window.innerHeight
          })
        );
      } else {
        handleCharacterInteraction(pointerDownTargetY);
      }
    }

    character.addEventListener("pointerdown", onPointerDown);
    character.addEventListener("pointermove", onPointerMove);
    character.addEventListener("pointerup", onPointerUp);
    character.addEventListener("pointercancel", onPointerUp);

    // 2. 部位交互动作与中文简体反馈
    function handleCharacterInteraction(relativeY: number) {
      if (relativeY < 0.38) {
        playMascotMotion("flick_head", 4);
        const quote = HEAD_PAT_QUOTES[Math.floor(Math.random() * HEAD_PAT_QUOTES.length)];
        showBubble(quote, 3200);
      } else {
        playMascotMotion("tap_body", 4);
        const quote = BODY_POKE_QUOTES[Math.floor(Math.random() * BODY_POKE_QUOTES.length)];
        showBubble(quote, 3200);
      }
    }

    // 3. 气泡台词触发
    let bubbleTimer: any = null;
    let quoteIndex = Math.floor(Math.random() * MASCOT_QUOTES.length);

    function showBubble(text?: string, duration = 4200) {
      if (isClosed || !bubble || !bubbleText) return;
      const content = text || MASCOT_QUOTES[quoteIndex % MASCOT_QUOTES.length];
      quoteIndex++;

      bubbleText.textContent = content;
      bubble.classList.add("is-visible");

      clearTimeout(bubbleTimer);
      bubbleTimer = setTimeout(hideBubble, duration);
    }

    function hideBubble() {
      if (!bubble) return;
      bubble.classList.remove("is-visible");
      clearTimeout(bubbleTimer);
    }

    if (bubbleClose) {
      bubbleClose.addEventListener("click", (e) => {
        e.stopPropagation();
        hideBubble();
      });
    }

    // 4. 工具栏交互动作
    const toolbar = widget.querySelector(".mascot-toolbar");
    if (toolbar) {
      toolbar.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest(".toolbar-btn") as HTMLElement;
        if (!btn) return;
        const action = btn.dataset.action;

        if (action === "ai") {
          toggleAiBox();
        } else if (action === "talk") {
          playMascotMotion("talk", 3);
          showBubble();
        } else if (action === "motion") {
          playMascotMotion("flick_head", 4);
          const text = MOTION_QUOTES[Math.floor(Math.random() * MOTION_QUOTES.length)];
          showBubble(text, 3000);
        } else if (action === "particles") {
          const isEnabled = localStorage.getItem("fly_particles_enabled") !== "0";
          const next = !isEnabled;
          window.dispatchEvent(new CustomEvent("fly:toggle-particles", { detail: { enable: next } }));
          if (next) {
            playMascotMotion("flick_head", 4);
            showBubble("已为主人开启唯美落樱与冰晶微光~ 🌸", 3200);
          } else {
            showBubble("已为您暂时关闭背景飘落动效~ ✨", 2600);
          }
        } else if (action === "top") {
          window.scrollTo({ top: 0, behavior: "smooth" });
          showBubble("咻~ 已经带您回到页面顶部啦！", 2200);
        } else if (action === "close") {
          closeMascot();
        }
      });
    }

    // 5. AI 智能对话系统 (屏幕居中专业聊天室，支持头像、气泡方向、打字动画、快捷清空)
    function toggleAiBox() {
      if (!aiBox) return;
      if (aiBox.classList.contains("is-open")) {
        closeAiBox();
      } else {
        openAiBox();
      }
    }

    function openAiBox() {
      if (!aiBox) return;
      document.body.style.overflow = "hidden";
      aiBackdrop?.classList.add("is-open");
      aiBackdrop?.removeAttribute("hidden");
      aiBox.classList.add("is-open");
      aiBox.removeAttribute("hidden");
      widget.classList.add("ai-open");
      hideBubble();
      playMascotMotion("talk", 3);
      setTimeout(() => {
        aiInput?.focus();
        if (aiMsgs) {
          aiMsgs.scrollTop = aiMsgs.scrollHeight;
        }
      }, 60);
    }

    function closeAiBox() {
      if (!aiBox) return;
      document.body.style.overflow = "";
      aiBackdrop?.classList.remove("is-open");
      aiBackdrop?.setAttribute("hidden", "true");
      aiBox.classList.remove("is-open");
      aiBox.setAttribute("hidden", "true");
      widget.classList.remove("ai-open");
    }

    // 拦截对话框滚轮事件，阻止冒泡到页面主体，彻底防止背景页面滚动穿透
    if (aiBox) {
      aiBox.addEventListener("wheel", (e) => {
        e.stopPropagation();
      }, { passive: true });
    }
    if (aiMsgs) {
      aiMsgs.addEventListener("wheel", (e) => {
        e.stopPropagation();
      }, { passive: true });
    }

    // 点击右上角关闭按钮
    if (aiClose) {
      aiClose.addEventListener("click", (e) => {
        e.stopPropagation();
        closeAiBox();
      });
    }

    // 点击背景遮罩关闭
    if (aiBackdrop) {
      aiBackdrop.addEventListener("click", () => {
        closeAiBox();
      });
    }

    // 按 Esc 键快捷收起
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && aiBox && aiBox.classList.contains("is-open")) {
        closeAiBox();
      }
    });

    // 格式化当前时间 (HH:MM)
    function formatTime(): string {
      const d = new Date();
      const h = String(d.getHours()).padStart(2, "0");
      const m = String(d.getMinutes()).padStart(2, "0");
      return `${h}:${m}`;
    }

    function escapeHtml(text: string): string {
      return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    // 初始欢迎消息 HTML (清爽自然女仆对话，杜绝刻板 AI 卡片)
    const initialWelcomeHtml = `
      <div class="chat-row is-bot">
        <div class="chat-avatar bot-avatar">
          <img src="/live2d/rem/avatar.png" alt="雷姆" width="40" height="40" />
        </div>
        <div class="chat-body">
          <div class="chat-meta">
            <span class="chat-name">雷姆</span>
            <span class="chat-time">在线</span>
          </div>
          <div class="chat-bubble bot-bubble">
            <p>主人好呀！我是雷姆~ 今天写代码还顺利吗？无论是遇到工程架构难题、技术选型，还是想闭目休息聊聊天，雷姆都会一直陪在您身边哦~</p>
          </div>
        </div>
      </div>
    `;

    // 清空历史对话记录
    if (aiClear && aiMsgs) {
      aiClear.addEventListener("click", () => {
        aiMsgs.innerHTML = initialWelcomeHtml;
        if (aiInput) aiInput.value = "";
        aiMsgs.scrollTop = 0;
      });
    }

    // 支持 Enter 快捷发送，Shift+Enter 换行
    if (aiInput && aiForm) {
      aiInput.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Enter" && !e.shiftKey) {
          e.preventDefault();
          aiForm.dispatchEvent(new Event("submit", { cancelable: true }));
        }
      });
    }

    if (aiForm) {
      aiForm.addEventListener("submit", (e) => {
        e.preventDefault();
        const text = aiInput?.value?.trim();
        if (text) {
          handleAiSubmit(text);
          if (aiInput) aiInput.value = "";
        }
      });
    }

    function appendUserMessage(text: string) {
      if (!aiMsgs) return;
      const row = document.createElement("div");
      row.className = "chat-row is-user";
      row.innerHTML = `
        <div class="chat-body">
          <div class="chat-meta">
            <span class="chat-time">${formatTime()}</span>
            <span class="chat-name">我</span>
          </div>
          <div class="chat-bubble user-bubble">${escapeHtml(text)}</div>
        </div>
        <div class="chat-avatar user-avatar">
          <img src="/live2d/rem/user-avatar.svg" alt="我" width="40" height="40" />
        </div>
      `;
      aiMsgs.appendChild(row);
      aiMsgs.scrollTop = aiMsgs.scrollHeight;
    }

    function appendBotThinking(): HTMLElement {
      const row = document.createElement("div");
      row.className = "chat-row is-bot is-thinking";
      row.innerHTML = `
        <div class="chat-avatar bot-avatar">
          <img src="/live2d/rem/avatar.png" alt="雷姆" width="40" height="40" />
        </div>
        <div class="chat-body">
          <div class="chat-meta">
            <span class="chat-name">雷姆</span>
            <span class="chat-time">正在思考...</span>
          </div>
          <div class="chat-bubble bot-bubble thinking-bubble">
            <div class="typing-indicator">
              <span></span><span></span><span></span>
            </div>
          </div>
        </div>
      `;
      aiMsgs?.appendChild(row);
      if (aiMsgs) aiMsgs.scrollTop = aiMsgs.scrollHeight;
      return row;
    }

    function updateBotMessage(row: HTMLElement, text: string) {
      row.classList.remove("is-thinking");
      const metaTime = row.querySelector(".chat-time");
      if (metaTime) metaTime.textContent = formatTime();

      const bubble = row.querySelector(".chat-bubble");
      if (bubble) {
        bubble.className = "chat-bubble bot-bubble";
        const paragraphs = text
          .split("\n\n")
          .map((p) => `<p>${escapeHtml(p).replace(/\n/g, "<br/>")}</p>`)
          .join("");
        bubble.innerHTML = paragraphs;
      }
      if (aiMsgs) aiMsgs.scrollTop = aiMsgs.scrollHeight;
    }

    async function handleAiSubmit(query: string) {
      if (!aiMsgs) return;

      appendUserMessage(query);
      const thinkingRow = appendBotThinking();

      playMascotMotion("talk", 3);

      try {
        const res = await fetch("/api/jarvis/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            apiBase: "https://api.deepseek.com/v1",
            model: "deepseek-chat",
            messages: [
              {
                role: "system",
                content:
                  "你是技术博客 FlyCodeCenter 的专属女仆看板娘雷姆。说话口吻温柔坚定、元气可爱，使用纯正自然的简体中文。你热爱编程与前沿技术架构，能针对开发者遇到的工程难题、架构设计与学习路线，给出结构清晰、专业准确且充满温度与鼓励的解答。"
              },
              { role: "user", content: query }
            ]
          })
        });

        if (res.ok) {
          const answer = (await res.text()).trim();
          if (answer) {
            updateBotMessage(thinkingRow, answer);
            playMascotMotion("talk", 3);
            return;
          }
        }
      } catch (err) {}

      // 本地智能知识库匹配解答
      let reply = LOCAL_KNOWLEDGE["默认"];
      const lower = query.toLowerCase();
      if (lower.includes("推荐") || lower.includes("文章") || lower.includes("博客")) {
        reply = LOCAL_KNOWLEDGE["推荐文章"];
      } else if (lower.includes("seaweedfs") || lower.includes("minio") || lower.includes("存储")) {
        reply = LOCAL_KNOWLEDGE["seaweedfs"];
      } else if (lower.includes("路线") || lower.includes("全栈") || lower.includes("学")) {
        reply = LOCAL_KNOWLEDGE["学习路线"];
      } else if (lower.includes("累") || lower.includes("鼓励") || lower.includes("安慰") || lower.includes("难受")) {
        reply = LOCAL_KNOWLEDGE["鼓励"];
      }

      updateBotMessage(thinkingRow, reply);
      playMascotMotion("talk", 3);
    }

    // 6. 打开与收起状态同步
    function closeMascot() {
      hideBubble();
      closeAiBox();
      widget.classList.add("is-closing");
      setTimeout(() => {
        isClosed = true;
        localStorage.setItem(STORAGE_KEY_CLOSED, "1");
        syncDisplayState(true);
        widget.classList.remove("is-closing");
      }, 250);
    }

    function openMascot() {
      isClosed = false;
      closeAiBox();
      localStorage.setItem(STORAGE_KEY_CLOSED, "0");
      syncDisplayState(true);
      playMascotMotion("talk", 3);
      setTimeout(() => {
        showBubble(`主人好，我是【${REM_MODEL.name}】~ 有什么可以帮您的吗？`, 3000);
      }, 150);
    }

    summonerBtn.addEventListener("click", () => {
      openMascot();
    });

    function syncDisplayState(withAnim = true) {
      if (isClosed) {
        widget.style.display = "none";
        summonerBtn.style.display = "inline-flex";
      } else {
        widget.style.display = "flex";
        summonerBtn.style.display = "none";
      }
    }

    function updateFlipState(x: number) {
      if (x < 240) {
        widget.classList.add("flip-left");
      } else {
        widget.classList.remove("flip-left");
      }
    }

    function restorePosition() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY_POS);
        if (!saved) return;
        const pos = JSON.parse(saved);
        const wWidth = window.innerWidth;
        const wHeight = window.innerHeight;

        let targetX: number | null = null;
        let targetY: number | null = null;

        if (typeof pos.x === "number") {
          targetX = pos.x;
        } else if (typeof pos.offsetLeft === "number") {
          targetX = pos.offsetLeft;
        } else if (typeof pos.offsetRight === "number") {
          targetX = wWidth - 250 - pos.offsetRight;
        }

        if (typeof pos.y === "number") {
          targetY = pos.y;
        } else if (typeof pos.offsetTop === "number") {
          targetY = pos.offsetTop;
        } else if (typeof pos.offsetBottom === "number") {
          targetY = wHeight - 380 - pos.offsetBottom;
        }

        if (targetX !== null && targetY !== null) {
          const clamped = clampPosition(targetX, targetY);
          root.style.left = `${clamped.x}px`;
          root.style.top = `${clamped.y}px`;
          root.style.right = "auto";
          root.style.bottom = "auto";
          updateFlipState(clamped.x);
        }
      } catch {}
    }

    // 视口尺寸变化时，仅当窗口缩小导致完全不可见时才做防溢出保护，平时绝不自动移动
    window.addEventListener(
      "resize",
      () => {
        if (root.style.left && root.style.left !== "auto") {
          const curX = parseFloat(root.style.left) || 0;
          const curY = parseFloat(root.style.top) || 0;
          if (curX > window.innerWidth || curY > window.innerHeight) {
            const clamped = clampPosition(curX, curY);
            root.style.left = `${clamped.x}px`;
            root.style.top = `${clamped.y}px`;
            updateFlipState(clamped.x);
          }
        }
      },
      { passive: true }
    );
  }

  // Astro 页面过渡生命周期兼容
  document.addEventListener("astro:page-load", initMascot);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initMascot();
  }
</script>
