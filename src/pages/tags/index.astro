---
import siteConfig from "@/site.config";
import ListLayout from "@/layouts/ListLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { fetchTaxonomyEntries, makeTagItems } from "@/utils/query";
import { resolveArticleMeta } from "@/utils/article-meta";
import { buildTagGraphItems } from "@/utils/tag-graph";

const entries = await fetchTaxonomyEntries();
const tags = makeTagItems(entries);
const totalTagRefs = tags.reduce((sum, item) => sum + item.count, 0);
const topTags = tags.slice(0, siteConfig.taxonomy.showTopN);
const tagCoverMode = siteConfig.blog.pageCardOverrides.tags.coverMode;

const graphConfig = siteConfig.taxonomy.tagGraph;
const graphItems = buildTagGraphItems(topTags, {
  minFontSize: graphConfig.minFontSize,
  maxFontSize: graphConfig.maxFontSize,
  minWeight: graphConfig.minWeight,
  maxWeight: graphConfig.maxWeight,
  alphaMin: graphConfig.alphaMin,
  alphaMax: graphConfig.alphaMax
});

const tagsPageConfig = (siteConfig.pages as {
  tags?: {
    list?: { mode?: "page" | "infinite"; pageSize?: number };
    antiCrawl?: { enable?: boolean; lockOnSuspicious?: boolean; maxActions?: number; timeWindowMs?: number };
  };
}).tags ?? { list: { mode: "page", pageSize: 10 }, antiCrawl: { enable: true, lockOnSuspicious: true, maxActions: 10, timeWindowMs: 20000 } };

const listMode = tagsPageConfig.list?.mode ?? "page";
const pageSize = tagsPageConfig.list?.pageSize ?? 10;
---

<ListLayout
  title="标签中心"
  description="按热度图谱筛选标签，支持分页与无限滚动两种浏览模式。"
  stats={[
    { title: "标签总数", value: tags.length },
    { title: "内容总数", value: entries.length },
    { title: "标签引用", value: totalTagRefs }
  ]}
  tags={tags}
>
  <div class="tags-page-root">
    <section class="tag-filter surface" id="tag-filter-root">
      <header class="tag-filter-head">
        <div class="tag-head-title">
          <span class="tag-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
              <line x1="7" y1="7" x2="7.01" y2="7"></line>
            </svg>
          </span>
          <h2>技术主题索引</h2>
        </div>
        <p id="tag-filter-status" class="tag-status-badge">全部标签 · {entries.length} 篇文章</p>
      </header>

      <div class={`tag-graph layout-${graphConfig.layout}`} role="listbox" aria-label="标签筛选">
        <button type="button" class="tag-node is-all active" data-tag="all">
          <span class="node-label">全部</span>
          <span class="node-count">{entries.length}</span>
        </button>
        {
          graphItems.map((item) => (
            <button type="button" class="tag-node" data-tag={item.name} title={item.name}>
              <span class="node-label">{item.name}</span>
              <span class="node-count">{item.count}</span>
            </button>
          ))
        }
      </div>
    </section>

    <section class="tag-result-section" id="tag-result-section">
      <div class="result-list" id="tag-result-list" data-list-mode={listMode} data-page-size={String(pageSize)}>
        {
          entries.map((entry, idx) => (
            <div
              data-entry-item
              data-entry-index={String(idx)}
              data-tags={resolveArticleMeta(entry).tags.map((tag) => tag.trim().toLowerCase()).join("||")}
            >
              <PostCard entry={entry} kind={entry.collection} coverMode={tagCoverMode} />
            </div>
          ))
        }
      </div>
      <nav class="surface pager-shell tag-pager" id="tag-result-pager" hidden></nav>
      <div id="tag-result-sentinel" aria-hidden="true"></div>
    </section>
  </div>
</ListLayout>

<script is:inline>
  const initTagFilter = () => {
    const root = document.getElementById("tag-filter-root");
    const list = document.getElementById("tag-result-list");
    const status = document.getElementById("tag-filter-status");
    const pager = document.getElementById("tag-result-pager");
    const sentinel = document.getElementById("tag-result-sentinel");
    if (!(root instanceof HTMLElement) || !(list instanceof HTMLElement) || !(status instanceof HTMLElement) || !(sentinel instanceof HTMLElement)) return;

    if (window.__flyTagFilterRoot === root && window.__flyTagFilterCleanup) return;
    if (window.__flyTagFilterCleanup) {
      window.__flyTagFilterCleanup();
    }
    window.__flyTagFilterRoot = root;

    const controller = new AbortController();
    const { signal } = controller;
    const buttons = Array.from(root.querySelectorAll(".tag-node"));
    const items = Array.from(list.querySelectorAll("[data-entry-item]"));
    const normalize = (value) => String(value || "").trim().toLowerCase();
    const listMode = list.dataset.listMode === "infinite" ? "infinite" : "page";
    const pageSize = Math.max(1, Number.parseInt(list.dataset.pageSize || "10", 10));

    let currentTag = "all";
    let filteredItems = [];
    let currentPage = 1;
    let observer = null;

    const revealNextBatch = () => {
      let revealed = 0;
      for (const item of filteredItems) {
        if (!item.hasAttribute("hidden")) continue;
        item.removeAttribute("hidden");
        revealed += 1;
        if (revealed >= pageSize) break;
      }
      const hasHidden = filteredItems.some((item) => item.hasAttribute("hidden"));
      sentinel.hidden = !hasHidden;
      return hasHidden;
    };

    const updateStatus = () => {
      const activeButton = buttons.find((button) => normalize(button.getAttribute("data-tag")) === currentTag);
      const label = currentTag === "all" ? "全部标签" : activeButton?.getAttribute("data-tag") || currentTag;
      status.textContent = `${label} · ${filteredItems.length} 篇文章`;
    };

    const renderPager = () => {
      if (!(pager instanceof HTMLElement)) return;
      if (listMode !== "page") {
        pager.hidden = true;
        return;
      }
      const totalPages = Math.max(1, Math.ceil(filteredItems.length / pageSize));
      if (totalPages <= 1) {
        pager.hidden = true;
        return;
      }
      const windowPages = (current, total) => {
        if (total <= 7) return Array.from({ length: total }, (_, idx) => idx + 1);
        const picked = [...new Set([1, total, current - 1, current, current + 1])]
          .filter((page) => page >= 1 && page <= total)
          .sort((a, b) => a - b);
        const out = [];
        let prev = 0;
        for (const page of picked) {
          if (page - prev > 1) out.push("ellipsis");
          out.push(page);
          prev = page;
        }
        return out;
      };
      const pageButtons = windowPages(currentPage, totalPages)
        .map((pageNo) =>
          pageNo === "ellipsis"
            ? `<span class="pager-ellipsis" aria-hidden="true">…</span>`
            : `<button type="button" class="pager-btn pager-btn-num ${pageNo === currentPage ? "is-active" : ""}" data-page="${pageNo}">${pageNo}</button>`
        )
        .join("");
      pager.innerHTML = `
        <button type="button" class="pager-btn" data-page="${currentPage - 1}" ${currentPage <= 1 ? "disabled" : ""}>上一页</button>
        <div class="pager-pages">${pageButtons}</div>
        <button type="button" class="pager-btn" data-page="${currentPage + 1}" ${currentPage >= totalPages ? "disabled" : ""}>下一页</button>
      `;
      pager.hidden = false;
    };

    const setVisibilityPage = () => {
      const start = (currentPage - 1) * pageSize;
      const end = start + pageSize;
      filteredItems.forEach((item, idx) => item.toggleAttribute("hidden", idx < start || idx >= end));
      renderPager();
      sentinel.hidden = true;
    };

    const setVisibilityInfinite = () => {
      filteredItems.forEach((item, idx) => item.toggleAttribute("hidden", idx >= pageSize));
      const hasMore = filteredItems.length > pageSize;
      if (observer) observer.disconnect();
      sentinel.hidden = !hasMore;
      if (!hasMore) return;

      observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const hasMoreNext = revealNextBatch();
            if (!hasMoreNext && observer) observer.disconnect();
          }
        },
        { rootMargin: "220px 0px 320px 0px", threshold: 0.01 }
      );
      observer.observe(sentinel);
    };

    const applyFilter = (rawTag, syncQuery = true) => {
      currentTag = normalize(rawTag) === "all" ? "all" : normalize(rawTag);
      buttons.forEach((button) => {
        const isActive = normalize(button.getAttribute("data-tag")) === currentTag;
        button.classList.toggle("active", isActive);
      });

      filteredItems = [];
      for (const item of items) {
        const tagsText = item.getAttribute("data-tags") || "";
        const tagSet = tagsText ? tagsText.split("||").map(normalize) : [];
        const visible = currentTag === "all" || tagSet.includes(currentTag);
        item.toggleAttribute("hidden", !visible);
        if (visible) filteredItems.push(item);
      }

      currentPage = 1;
      if (listMode === "page") {
        setVisibilityPage();
      } else {
        if (pager instanceof HTMLElement) pager.hidden = true;
        setVisibilityInfinite();
      }
      updateStatus();

      if (syncQuery) {
        const url = new URL(window.location.href);
        if (currentTag === "all") url.searchParams.delete("tag");
        else url.searchParams.set("tag", currentTag);
        window.history.replaceState({}, "", `${url.pathname}${url.search}${url.hash}`);
      }
    };

    buttons.forEach((button) => {
      button.addEventListener(
        "click",
        () => {
          applyFilter(button.getAttribute("data-tag") || "all");
        },
        { signal }
      );
    });

    if (pager instanceof HTMLElement) {
      pager.addEventListener(
        "click",
        (event) => {
          const target = event.target;
          if (!(target instanceof HTMLElement)) return;
          const btn = target.closest("button[data-page]");
          if (!(btn instanceof HTMLButtonElement) || btn.disabled) return;
          const next = Number.parseInt(btn.dataset.page || "1", 10);
          if (!Number.isFinite(next)) return;
          currentPage = next;
          setVisibilityPage();
        },
        { signal }
      );
    }

    const queryTag = new URLSearchParams(window.location.search).get("tag");
    if (queryTag) {
      const target = buttons.find((button) => normalize(button.getAttribute("data-tag")) === normalize(queryTag));
      applyFilter(target?.getAttribute("data-tag") || "all", false);
    } else {
      applyFilter("all", false);
    }

    window.__flyTagFilterCleanup = () => {
      controller.abort();
      if (observer) observer.disconnect();
      if (window.__flyTagFilterRoot === root) {
        window.__flyTagFilterRoot = null;
        window.__flyTagFilterCleanup = null;
      }
    };
  };

  if (!window.__flyTagFilterPageLoadBound) {
    window.__flyTagFilterPageLoadBound = true;
    document.addEventListener("astro:page-load", initTagFilter);
  }
  initTagFilter();
</script>

<style is:global>
  .tags-page-root {
    display: grid;
    gap: var(--space-4);
  }

  .tags-page-root .tag-filter {
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in oklab, var(--line) 84%, transparent 16%);
    background: color-mix(in oklab, var(--bg-elev) 92%, transparent 8%);
    display: grid;
    gap: 0.95rem;
    box-shadow: 0 4px 12px -6px rgb(0 0 0 / 0.06);
  }

  .tags-page-root .tag-filter-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    flex-wrap: wrap;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid color-mix(in oklab, var(--line) 75%, transparent 25%);
  }

  .tags-page-root .tag-head-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tags-page-root .tag-icon {
    display: inline-flex;
    align-items: center;
    color: var(--brand);
  }

  .tags-page-root .tag-head-title h2 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
  }

  .tags-page-root .tag-status-badge {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-muted);
    background: color-mix(in oklab, var(--surface-2) 80%, transparent 20%);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--line) 75%, transparent 25%);
    font-family: var(--font-tech);
  }

  .tags-page-root .tag-graph {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.55rem;
    padding: 0.15rem 0;
  }

  .tags-page-root .tag-node {
    border: 1px solid color-mix(in oklab, var(--line) 82%, transparent 18%);
    background: color-mix(in oklab, var(--surface-2) 75%, transparent 25%);
    border-radius: 999px;
    padding: 0.28rem 0.68rem;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--text-soft);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: all 160ms cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    text-align: left;
    line-height: 1.25;
  }

  .tags-page-root .tag-node:hover {
    color: var(--brand);
    border-color: color-mix(in oklab, var(--brand) 40%, var(--line) 60%);
    background: color-mix(in oklab, var(--brand-soft) 40%, var(--bg-elev) 60%);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px -4px color-mix(in oklab, var(--brand) 25%, transparent 75%);
  }

  .tags-page-root .node-label {
    min-width: 0;
  }

  .tags-page-root .node-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.04rem 0.36rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-family: var(--font-tech);
    color: var(--text-muted);
    background: color-mix(in oklab, var(--bg) 85%, transparent 15%);
    border: 1px solid color-mix(in oklab, var(--line) 80%, transparent 20%);
    transition: all 160ms ease;
  }

  .tags-page-root .tag-node.active {
    background: var(--brand) !important;
    color: #fff !important;
    border-color: var(--brand) !important;
    box-shadow: 0 4px 14px -3px var(--brand);
    transform: translateY(-1px);
  }

  .tags-page-root .tag-node.active .node-count {
    background: rgb(255 255 255 / 0.22);
    color: #fff;
    border-color: transparent;
  }

  .tags-page-root .tag-result-section {
    display: grid;
    gap: var(--space-4);
  }

  .tags-page-root .result-list {
    display: grid;
    gap: var(--space-4);
  }

  .tags-page-root .tag-pager {
    margin-top: 0.1rem;
    padding: 0.5rem 0.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: var(--radius-md);
  }

  .tags-page-root .pager-pages {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .tags-page-root .pager-btn {
    border: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--text-soft);
    padding: 0.28rem 0.6rem;
    border-radius: 6px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.14s ease;
  }

  .tags-page-root .pager-btn:hover:not(:disabled) {
    color: var(--brand);
    border-color: var(--brand);
  }

  .tags-page-root .pager-btn.is-active {
    background: var(--brand);
    color: #fff;
    border-color: var(--brand);
  }

  .tags-page-root .pager-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .tags-page-root .pager-ellipsis {
    color: var(--text-muted);
    padding: 0 0.2rem;
  }

  #tag-result-sentinel {
    width: 100%;
    height: 2px;
  }
</style>
