---
import siteConfig from "@/site.config";
import ListLayout from "@/layouts/ListLayout.astro";
import PostCard from "@/components/PostCard.astro";
import Pagination from "@/components/Pagination.astro";
import { fetchTaxonomyEntries, makeTagItems } from "@/utils/query";
import { resolveArticleMeta } from "@/utils/article-meta";

export async function getStaticPaths() {
  const entries = await fetchTaxonomyEntries();
  const tags = new Set<string>();
  for (const entry of entries) {
    for (const tag of resolveArticleMeta(entry).tags) tags.add(tag);
  }
  return [...tags].map((tag) => ({
    params: { tag },
    props: { tag }
  }));
}

const { tag } = Astro.props;
const allEntries = await fetchTaxonomyEntries();
const matched = allEntries.filter((entry) => resolveArticleMeta(entry).tags.includes(tag));
const tags = makeTagItems(allEntries);
const mode = siteConfig.blog.pagination.mode;
const pageSize = siteConfig.blog.pagination.pageSize;
const tagCoverMode = siteConfig.blog.pageCardOverrides.tags.coverMode;
---

<ListLayout
  title={`标签：${tag}`}
  description={`探索包含「${tag}」标签的技术文章与实战教程。`}
  stats={[
    { title: "命中结果", value: matched.length },
    { title: "全部标签", value: tags.length, href: "/tags" }
  ]}
  tags={tags}
>
  <div class="tag-detail-root">
    <header class="tag-header-card surface">
      <div class="tag-meta-summary">
        <span class="tag-hash-chip">#</span>
        <div class="tag-text-block">
          <h2>{tag}</h2>
          <p>该技术标签下共收录 <strong>{matched.length}</strong> 篇技术文章与系统教程</p>
        </div>
      </div>
      <a href="/tags" class="all-tags-link">全部标签列表 →</a>
    </header>

    <div class="list" id="tag-post-list">
      {
        matched.map((entry, idx) => (
          <div data-page-item hidden={mode === "loadMore" && idx >= pageSize ? true : undefined}>
            <PostCard entry={entry} kind={entry.collection} coverMode={tagCoverMode} />
          </div>
        ))
      }
    </div>

    {
      mode === "loadMore" && <Pagination mode="loadMore" targetSelector="#tag-post-list" batchSize={pageSize} />
    }
  </div>
</ListLayout>

<style is:global>
  .tag-detail-root {
    display: grid;
    gap: var(--space-4);
  }

  .tag-header-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in oklab, var(--line) 84%, transparent 16%);
    background: color-mix(in oklab, var(--bg-elev) 92%, transparent 8%);
  }

  .tag-meta-summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .tag-hash-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    font-size: 1.2rem;
    font-weight: 700;
    font-family: var(--font-tech);
    color: var(--brand);
    background: color-mix(in oklab, var(--brand-soft) 40%, var(--bg-elev) 60%);
    border: 1px solid color-mix(in oklab, var(--brand) 28%, var(--line) 72%);
    flex: 0 0 auto;
  }

  .tag-text-block h2 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
  }

  .tag-text-block p {
    margin: 0.15rem 0 0;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .tag-text-block strong {
    color: var(--brand);
    font-family: var(--font-tech);
  }

  .all-tags-link {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.14s ease;
  }

  .all-tags-link:hover {
    color: var(--brand);
  }

  .tag-detail-root .list {
    display: grid;
    gap: var(--space-4);
  }

  @media (max-width: 640px) {
    .tag-header-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }
  }
</style>
