---
import type { CollectionEntry } from "astro:content";
import siteConfig from "@/site.config";
import ListLayout from "@/layouts/ListLayout.astro";
import { fetchAllContentEntries, fetchAllEntries, makeTagItems } from "@/utils/query";
import { buildArchiveTimeline } from "@/utils/archive";
import { getBlogEntryUrl, getTutorialEntryUrl } from "@/utils/content";
import { resolveArticleMeta } from "@/utils/article-meta";
import { resolveAntiCrawlRuntimeConfig, type AntiCrawlConfigInput } from "@/utils/anti-crawl";

const entries = await fetchAllEntries();
const allContent = await fetchAllContentEntries();
const tags = makeTagItems(allContent);
const years = buildArchiveTimeline(entries);

const archivePageConfig = siteConfig.pages.archives as {
  antiCrawl?: AntiCrawlConfigInput;
};

const antiCrawlConfig = archivePageConfig.antiCrawl ?? {};
const antiCrawlRuntime = resolveAntiCrawlRuntimeConfig(antiCrawlConfig, { legacyMaxActionsDefault: 10 });

type ArchiveEntry = CollectionEntry<"blog"> | CollectionEntry<"tutorial">;

const getEntryLink = (entry: ArchiveEntry) =>
  entry.collection === "blog"
    ? getBlogEntryUrl(entry as CollectionEntry<"blog">)
    : getTutorialEntryUrl(entry as CollectionEntry<"tutorial">);

const yearGroups = years.map((yearBucket) => {
  const items = yearBucket.months.flatMap((monthBucket) =>
    monthBucket.days.flatMap((dayBucket) =>
      dayBucket.entries.map((entry) => {
        const meta = resolveArticleMeta(entry as ArchiveEntry);
        return {
          entry: entry as ArchiveEntry,
          meta,
          link: getEntryLink(entry as ArchiveEntry),
          dateLabel: `${String(dayBucket.month).padStart(2, "0")}-${String(dayBucket.day).padStart(2, "0")}`,
          dayKey: dayBucket.key
        };
      })
    )
  );
  return { year: yearBucket.year, count: items.length, items };
});
---

<ListLayout title="归档" description="博客与教程统一归档，按年份倒序排列。" tags={tags}>
  <section class="archive-list" id="archive-timeline">
    {
      yearGroups.map((group) => (
        <section class="archive-year">
          <header class="year-head">
            <h2>{group.year}</h2>
            <span class="year-count">{group.count} 篇</span>
          </header>
          <ul class="year-list">
            {group.items.map((item) => (
              <li class="timeline-item" data-day={item.dayKey}>
                <a class="entry-row" href={item.link}>
                  <time class="entry-date" datetime={item.meta.createTime.toISOString()}>
                    {item.dateLabel}
                  </time>
                  <span class="entry-title">{item.meta.title}</span>
                  <span class={`entry-kind kind-${item.entry.collection}`}>
                    {item.entry.collection === "blog" ? "博客" : "教程"}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <section class="archive-lock" id="archive-lock" hidden>
      <h2>访问已受限</h2>
      <p>检测到异常访问行为，归档内容已临时受限。</p>
      <p class="archive-lock-reason" id="archive-lock-reason"></p>
    </section>
  </section>
</ListLayout>

<script id="archive-anti-crawl-config" type="application/json" set:html={JSON.stringify(antiCrawlRuntime)} />
<script>
  import "@/scripts/archive-anti-crawl-runtime.js";
</script>

<style>
  .archive-list {
    display: grid;
    gap: var(--space-5);
  }

  .archive-year {
    display: grid;
    gap: var(--space-2);
  }

  .year-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--line);
  }

  .year-head h2 {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--text);
  }

  .year-count {
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .year-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
  }

  .entry-row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-3);
    padding: 0.52rem 0.5rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .entry-row:hover {
    background: color-mix(in oklab, var(--brand-soft) 36%, transparent 64%);
  }

  .entry-date {
    color: var(--text-muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .entry-title {
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.5;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .entry-row:hover .entry-title {
    color: var(--brand);
  }

  .entry-kind {
    font-size: 0.72rem;
    color: var(--text-muted);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.08rem 0.46rem;
    white-space: nowrap;
  }

  .entry-kind.kind-tutorial {
    color: color-mix(in oklab, var(--accent) 70%, var(--text-soft) 30%);
    border-color: color-mix(in oklab, var(--accent) 34%, var(--line) 66%);
  }

  .archive-lock {
    border: 1px solid color-mix(in oklab, var(--brand) 35%, var(--line) 65%);
    border-radius: 12px;
    background: color-mix(in oklab, var(--surface-1) 92%, var(--brand-soft) 8%);
    padding: 1rem;
    display: grid;
    gap: 0.5rem;
    z-index: 2;
  }

  .archive-lock[hidden] {
    display: none;
  }

  .archive-lock h2 {
    margin: 0;
    font-size: 1.08rem;
  }

  .archive-lock p {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  .archive-lock-reason {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .archive-list.is-locked .timeline-item,
  .archive-list.is-locked .year-head {
    opacity: 0.25;
    pointer-events: none;
    filter: blur(1px);
  }

  @media (max-width: 760px) {
    .entry-row {
      grid-template-columns: 46px minmax(0, 1fr);
      gap: var(--space-2);
    }

    .entry-kind {
      display: none;
    }

    .entry-title {
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
  }
</style>
