---
import siteConfig from "@/site.config";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { fetchSitesEntries } from "@/utils/query";
import { getTagColorVars } from "@/utils/tag-color";

const sourceEntries = await fetchSitesEntries();

const entries = await Promise.all(
  sourceEntries.map(async (entry) => {
    const cards = [...(entry.data.cards ?? [])].sort((a, b) => {
      if (Number(b.pinned) !== Number(a.pinned)) return Number(b.pinned) - Number(a.pinned);
      if ((a.order ?? 999) !== (b.order ?? 999)) return (a.order ?? 999) - (b.order ?? 999);
      return a.title.localeCompare(b.title, "zh-CN");
    });

    return {
      entry,
      category: (entry.data.category || entry.data.title || "未分类").trim(),
      cards
    };
  })
);

const groups = [...entries].sort((a, b) => (a.entry.data.order ?? 999) - (b.entry.data.order ?? 999));
const defaultCategory = String(siteConfig.pages.sites.filter.defaultCategory || "").trim();
const showFilter = siteConfig.pages.sites.filter.enable;
const resolvedDefaultCategory =
  defaultCategory.toLowerCase() === "all"
    ? "all"
    : groups.find((group) => group.category.toLowerCase() === defaultCategory.toLowerCase())?.category ??
      groups[0]?.category ??
      "";
const totalSiteCount = groups.reduce((sum, group) => sum + group.cards.length, 0);
const defaultSiteIcon = "/icons/site-default.svg";

const getHost = (url: string) => {
  try {
    return new URL(url).host.replace(/^www\./, "");
  } catch {
    return "";
  }
};

const resolveIcon = (url: string, icon: string, iconFetch?: boolean) => {
  if (icon?.trim()) return icon.trim();
  if (iconFetch === false) return "";
  const host = getHost(url);
  if (!host) return "";
  return `https://www.google.com/s2/favicons?domain=${encodeURIComponent(host)}&sz=64`;
};
---

<BaseLayout title={siteConfig.pages.sites.title} description={siteConfig.pages.sites.description}>
  <div class="sites-page-root">
    <section class={`vault-shell ${showFilter ? "" : "no-nav"}`} aria-labelledby="sites-page-title">
      <h1 id="sites-page-title" class="sr-only">{siteConfig.pages.sites.title}</h1>
      {
        showFilter && (
          <aside class="vault-nav surface" id="vault-nav">
            <button
              type="button"
              class={`nav-item${resolvedDefaultCategory === "all" ? " active" : ""}`}
              data-filter="all"
            >
              <span class="nav-label">全部收藏</span>
              <span class="nav-count">{totalSiteCount}</span>
            </button>
            {
              groups.map((group) => (
                <button
                  type="button"
                  class={`nav-item${group.category === resolvedDefaultCategory ? " active" : ""}`}
                  data-filter={group.category}
                  style={getTagColorVars(group.category)}
                >
                  <span class="nav-label">{group.category}</span>
                  <span class="nav-count">{group.cards.length}</span>
                </button>
              ))
            }
          </aside>
        )
      }

      <section class="vault-content">
        <section class="vault-groups" id="vault-groups" data-default={resolvedDefaultCategory}>
          {
            groups.map((group) => (
              <section
                class={`vault-group surface${resolvedDefaultCategory === "all" || group.category === resolvedDefaultCategory ? " is-active" : ""}`}
                data-group={group.category}
                aria-hidden={resolvedDefaultCategory === "all" || group.category === resolvedDefaultCategory ? "false" : "true"}
              >
                <div class="group-summary">
                  <div class="summary-text-wrap">
                    <h2 class="group-title">{group.category}</h2>
                    <p class="group-desc">{group.entry.data.description || "按该技术主题精选的高质量站点与实用工具。"}</p>
                  </div>
                  <span class="group-count">{group.cards.length} 个站点</span>
                </div>

                <div class="group-grid">
                  {
                    group.cards.map((card) => {
                      return (
                        <a
                          class="site-card"
                          href={card.url}
                          target="_blank"
                          rel="noreferrer"
                          title={`访问 ${card.title}`}
                        >
                          <header class="site-card-head">
                            <div class="site-icon-box">
                              <img
                                src={defaultSiteIcon}
                                data-icon-src={resolveIcon(card.url, card.icon, card.iconFetch)}
                                data-icon-key={getHost(card.url)}
                                alt=""
                                loading="lazy"
                                decoding="async"
                                referrerpolicy="no-referrer"
                              />
                            </div>
                            <div class="site-title-wrap">
                              <h3 title={card.title}>{card.title}</h3>
                              <span class="site-domain">{getHost(card.url)}</span>
                            </div>
                            <span class="site-external-arrow" aria-hidden="true">
                              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="7" y1="17" x2="17" y2="7"></line>
                                <polyline points="7 7 17 7 17 17"></polyline>
                              </svg>
                            </span>
                          </header>

                          <p class="site-desc">{card.desc || "暂无描述"}</p>

                          <div class="site-card-foot">
                            <div class="site-tags-line" aria-label="标签">
                              {card.tags.slice(0, 3).map((tag) => (
                                <span class="tag-badge meta-tag" style={getTagColorVars(tag)}>{tag}</span>
                              ))}
                            </div>
                          </div>
                        </a>
                      );
                    })
                  }
                </div>
              </section>
            ))
          }
        </section>
      </section>
    </section>
  </div>
</BaseLayout>

<script is:inline define:vars={{ defaultSiteIcon }}>
  const initVaultFilter = () => {
    const root = document.getElementById('vault-groups');
    const filter = document.getElementById('vault-nav');
    if (!root || !filter) return;

    if (window.__flySitesFilterRoot === root && window.__flySitesFilterCleanup) return;
    if (window.__flySitesFilterCleanup) {
      window.__flySitesFilterCleanup();
    }
    window.__flySitesFilterRoot = root;

    const controller = new AbortController();
    const { signal } = controller;

    const buttons = Array.from(filter.querySelectorAll('.nav-item'));
    const groups = Array.from(root.querySelectorAll('.vault-group'));
    const normalize = (value) => String(value || '').trim().toLowerCase();

    const setFilter = (value, syncQuery = true) => {
      const normalized = normalize(value || '');
      if (!normalized) return;
      const showAll = normalized === 'all';

      buttons.forEach((btn) => {
        btn.classList.toggle('active', normalize(btn.dataset.filter) === normalized);
      });

      let hasVisible = false;
      groups.forEach((group) => {
        const category = normalize(group.getAttribute('data-group'));
        const visible = showAll || normalized === category;
        if (visible) hasVisible = true;
        group.classList.toggle('is-active', visible);
        group.setAttribute('aria-hidden', String(!visible));
      });

      if (!hasVisible) {
        const fallback = buttons[0]?.dataset.filter || '';
        if (fallback && fallback !== value) {
          setFilter(fallback, syncQuery);
        }
        return;
      }

      if (syncQuery && hasVisible) {
        const url = new URL(window.location.href);
        if (showAll) {
          url.searchParams.delete('category');
        } else {
          const activeBtn = buttons.find((btn) => normalize(btn.dataset.filter) === normalized);
          if (activeBtn?.dataset.filter) {
            url.searchParams.set('category', activeBtn.dataset.filter);
          }
        }
        window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
      }
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', (event) => {
        event.preventDefault();
        setFilter(btn.dataset.filter || '');
      }, { signal });
    });

    const queryCategory = new URLSearchParams(window.location.search).get('category');
    const pickDefault = () => {
      const defaultFilter = root.getAttribute('data-default') || '';
      const hit = buttons.find((btn) => normalize(btn.dataset.filter) === normalize(defaultFilter));
      return hit?.dataset.filter || buttons[0]?.dataset.filter || '';
    };

    if (queryCategory) {
      const hit = buttons.find((btn) => normalize(btn.dataset.filter) === normalize(queryCategory));
      setFilter(hit?.dataset.filter || pickDefault(), false);
    } else {
      setFilter(pickDefault(), false);
    }

    window.__flySitesFilterCleanup = () => {
      controller.abort();
      if (window.__flySitesFilterRoot === root) {
        window.__flySitesFilterRoot = null;
        window.__flySitesFilterCleanup = null;
      }
    };
  };

  const initSiteIconCache = () => {
    const storageKey = "fly-sites-icon-fail";
    let failed = {};
    try {
      failed = JSON.parse(localStorage.getItem(storageKey) || "{}") || {};
    } catch {
      failed = {};
    }

    const save = () => {
      try {
        localStorage.setItem(storageKey, JSON.stringify(failed));
      } catch {}
    };

    document.querySelectorAll("img[data-icon-src]").forEach((img) => {
      if (!(img instanceof HTMLImageElement)) return;
      if (img.dataset.iconCacheBound === "1") return;
      const iconSrc = (img.dataset.iconSrc || "").trim();
      const key = (img.dataset.iconKey || "").trim();
      if (!iconSrc || !key) return;
      if (failed[key]) return;
      img.dataset.iconCacheBound = "1";

      img.addEventListener(
        "error",
        () => {
          failed[key] = 1;
          img.src = `${defaultSiteIcon}`;
          save();
        },
        { once: true }
      );

      img.src = iconSrc;
    });
  };

  if (!window.__flySitesPageLoadBound) {
    window.__flySitesPageLoadBound = true;
    document.addEventListener('astro:page-load', initVaultFilter);
    document.addEventListener('astro:page-load', initSiteIconCache);
  }
  initVaultFilter();
  initSiteIconCache();
</script>

<style is:global>
  .sites-page-root {
    width: 100%;
  }

  .vault-shell {
    display: grid;
    grid-template-columns: minmax(180px, 220px) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .vault-shell.no-nav {
    grid-template-columns: minmax(0, 1fr);
  }

  .vault-nav {
    position: sticky;
    top: calc(var(--layout-header-height, 72px) + var(--space-3));
    display: grid;
    gap: 0.4rem;
    padding: 0.75rem;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in oklab, var(--line) 84%, transparent 16%);
    background: color-mix(in oklab, var(--bg-elev) 94%, transparent 6%);
    backdrop-filter: blur(10px);
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    box-shadow: 0 4px 12px -6px rgb(0 0 0 / 0.06);
  }

  .vault-nav .nav-item {
    width: 100%;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-soft);
    border-radius: 8px;
    padding: 0.45rem 0.65rem;
    font-size: 0.82rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    cursor: pointer;
    text-align: left;
    transition: all 140ms ease;
  }

  .vault-nav .nav-item:hover {
    color: var(--brand);
    background: color-mix(in oklab, var(--surface-2) 65%, transparent 35%);
  }

  .vault-nav .nav-item.active {
    border-color: color-mix(in oklab, var(--brand) 32%, var(--line) 68%);
    background: color-mix(in oklab, var(--brand-soft) 42%, var(--bg-elev) 58%);
    color: var(--brand);
    font-weight: 600;
  }

  .vault-nav .nav-label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .vault-nav .nav-count {
    border: 1px solid color-mix(in oklab, var(--line) 80%, transparent 20%);
    border-radius: 999px;
    padding: 0.02rem 0.4rem;
    font-size: 0.68rem;
    font-family: var(--font-tech);
    background: color-mix(in oklab, var(--bg) 90%, transparent 10%);
    color: var(--text-muted);
    white-space: nowrap;
    transition: all 140ms ease;
  }

  .vault-nav .nav-item.active .nav-count {
    border-color: color-mix(in oklab, var(--brand) 30%, transparent 70%);
    color: var(--brand);
    background: color-mix(in oklab, var(--brand-soft) 50%, var(--bg) 50%);
  }

  .vault-content {
    min-width: 0;
  }

  .vault-groups {
    display: grid;
    gap: 1.5rem;
  }

  .vault-group {
    padding: 1.15rem 1.35rem;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in oklab, var(--line) 84%, transparent 16%);
    background: color-mix(in oklab, var(--bg-elev) 92%, transparent 8%);
    display: none;
    gap: 1.1rem;
    box-shadow: 0 4px 14px -6px rgb(0 0 0 / 0.06);
  }

  .vault-group.is-active {
    display: grid;
  }

  .group-summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid color-mix(in oklab, var(--line) 75%, transparent 25%);
    padding-bottom: 0.75rem;
  }

  .summary-text-wrap {
    display: grid;
    gap: 0.25rem;
  }

  .group-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
  }

  .group-desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .group-count {
    border: 1px solid color-mix(in oklab, var(--line) 80%, transparent 20%);
    border-radius: 999px;
    padding: 0.12rem 0.52rem;
    font-size: 0.72rem;
    font-family: var(--font-tech);
    color: var(--text-muted);
    background: color-mix(in oklab, var(--surface-2) 70%, transparent 30%);
    white-space: nowrap;
    align-self: flex-start;
  }

  .group-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .site-card {
    border: 1px solid color-mix(in oklab, var(--line) 82%, transparent 18%);
    border-radius: 10px;
    background: color-mix(in oklab, var(--surface-1) 95%, transparent 5%);
    padding: 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    text-decoration: none;
    min-height: 145px;
    transition: all 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-card:hover {
    border-color: color-mix(in oklab, var(--brand) 40%, var(--line) 60%);
    background: color-mix(in oklab, var(--surface-2) 65%, transparent 35%);
    box-shadow: 0 8px 18px -8px color-mix(in oklab, var(--brand) 22%, transparent 78%);
    transform: translateY(-2px);
  }

  .site-card-head {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .site-icon-box {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 1px solid color-mix(in oklab, var(--line) 80%, transparent 20%);
    background: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    overflow: hidden;
    padding: 2px;
  }

  .site-icon-box img {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .site-title-wrap {
    min-width: 0;
    flex: 1;
    display: grid;
    gap: 0.15rem;
  }

  .site-title-wrap h3 {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.35;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 140ms ease;
  }

  .site-card:hover .site-title-wrap h3 {
    color: var(--brand);
  }

  .site-domain {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-family: var(--font-tech);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .site-external-arrow {
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 160ms ease;
    opacity: 0.7;
    flex: 0 0 auto;
  }

  .site-card:hover .site-external-arrow {
    color: var(--brand);
    opacity: 1;
    transform: translate(2px, -2px);
  }

  .site-desc {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.8rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .site-card-foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.2rem;
  }

  .site-tags-line {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    overflow: hidden;
    white-space: nowrap;
  }

  .site-tags-line .meta-tag {
    font-size: 0.65rem;
    padding: 0.05rem 0.38rem;
    border-radius: 5px;
    flex: 0 0 auto;
    max-width: 110px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 900px) {
    .vault-shell {
      grid-template-columns: 1fr;
    }

    .vault-nav {
      position: static;
      max-height: none;
      display: flex;
      overflow-x: auto;
      overflow-y: hidden;
      gap: 0.5rem;
      padding: 0.5rem;
    }

    .vault-nav .nav-item {
      flex: 0 0 auto;
      white-space: nowrap;
      width: auto;
    }
  }

  @media (max-width: 600px) {
    .group-grid {
      grid-template-columns: 1fr;
    }

    .group-summary {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
  }
</style>
