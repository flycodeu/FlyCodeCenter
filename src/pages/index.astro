---
import BaseLayout from "@/layouts/BaseLayout.astro";
import siteConfig from "@/site.config";
import PostCard from "@/components/PostCard.astro";
import SidebarProfile from "@/components/SidebarProfile.astro";
import ContentCover from "@/components/ContentCover.astro";
import Watermark from "@/components/Watermark.astro";
import {
  fetchBlogEntries,
  filterHomeVisibleTutorialEntries,
  fetchTutorialEntries,
  makeTagItems
} from "@/utils/query";
import { getBlogEntryUrl, sortByDateDesc } from "@/utils/content";
import { resolveArticleMeta } from "@/utils/article-meta";
import { formatDate } from "@/utils/date";
import { buildResponsiveImageSources } from "@/utils/image";

const [blogs, tutorials] = await Promise.all([
  fetchBlogEntries(),
  fetchTutorialEntries()
]);
const homeVisibleTutorials = filterHomeVisibleTutorialEntries(tutorials);
const allEntries = sortByDateDesc([...blogs, ...tutorials]);
const homeFeedEntries = sortByDateDesc([...blogs, ...homeVisibleTutorials]);
const hero = siteConfig.home.hero;
const heroImageConfig = (hero.image ?? {}) as { enable?: boolean; src?: string; fallbackSrc?: string; alt?: string };
const heroImageSrc =
  String(heroImageConfig.src || "").trim() ||
  String(heroImageConfig.fallbackSrc || "").trim() ||
  "https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=2400&q=80";
const heroImageAlt = String(heroImageConfig.alt || "Hero Image").trim() || "Hero Image";
const heroImageSources = buildResponsiveImageSources(heroImageSrc, [768, 1200, 1600, 2400], 1600);
const featuredConfig = siteConfig.home.featured;
const tagCount = makeTagItems(allEntries).length;
const homeFeedConfig = (siteConfig.home as { feed?: { mode?: "page" | "infinite"; pageSize?: number; mixCollections?: readonly ("blog" | "tutorial")[] } }).feed ?? {};
const feedMode = homeFeedConfig.mode ?? "page";
const pageSize = homeFeedConfig.pageSize ?? 10;
const feedCollections = new Set(homeFeedConfig.mixCollections ?? ["blog", "tutorial"]);

const pinnedBlogs = blogs.filter((entry) => resolveArticleMeta(entry).pinned);
const featuredEntry =
  featuredConfig.enable
    ? pinnedBlogs[0] ?? (featuredConfig.fallbackToLatest ? blogs[0] : undefined)
    : undefined;
const featuredMeta = featuredEntry ? resolveArticleMeta(featuredEntry) : undefined;
const featuredLink = featuredEntry ? getBlogEntryUrl(featuredEntry) : "#";
const recentEntries = homeFeedEntries.filter((entry) => {
  if (!feedCollections.has(entry.collection)) return false;
  if (!featuredEntry) return true;
  return !(entry.collection === "blog" && entry.id === featuredEntry.id);
});

type CoverMode = "left" | "right" | "top" | "none";

function normalizeCoverMode(value: unknown): CoverMode | undefined {
  if (typeof value !== "string") return undefined;
  const mode = value.trim().toLowerCase();
  if (mode === "left" || mode === "right" || mode === "top" || mode === "none") return mode;
  return undefined;
}

const featuredDefaultMode = normalizeCoverMode(siteConfig.blog.listCard.defaultCoverMode) ?? "right";
const featuredEntryData = featuredEntry?.data as { coverMode?: string; coverPosition?: string } | undefined;
const featuredMode =
  normalizeCoverMode(featuredEntryData?.coverMode) ??
  normalizeCoverMode(featuredEntryData?.coverPosition) ??
  normalizeCoverMode(featuredMeta?.coverMode) ??
  featuredDefaultMode;
const showFeaturedCover = featuredMode !== "none";
const featuredImageSources = buildResponsiveImageSources(featuredMeta?.cover || "", [480, 768, 960, 1200], 960);
---

<BaseLayout>
  <div class="home-page">
    <div class="grid-main home-shell">
      <section class="home-main">
        {
          hero.enable && (
            <section class="hero surface fade-up">
              {siteConfig.watermark.enable && siteConfig.watermark.scope === "hero" && <Watermark scope="hero" />}
              {heroImageConfig.enable && heroImageSrc && (
                <div class="hero-bg">
                  <img
                    src={heroImageSources.src}
                    srcset={heroImageSources.srcset}
                    sizes="(max-width: 900px) calc(100vw - 32px), (max-width: 1280px) calc(100vw - 360px), 820px"
                    alt={heroImageAlt}
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                    referrerpolicy="no-referrer"
                  />
                </div>
              )}
              <div class="hero-content">
                <h1>{hero.title}</h1>
                {hero.tagline && <p class="tagline">{hero.tagline}</p>}
                <p class="description">{hero.description}</p>
                <div class="hero-metrics" aria-label="site-overview">
                  <span class="chip">{blogs.length} 篇博客</span>
                  <span class="chip">{tutorials.length} 篇教程</span>
                  <span class="chip">{tagCount} 个标签</span>
                </div>
                {hero.actions?.length ? (
                  <div class="hero-actions">
                    {hero.actions.slice(0, 3).map((action) => (
                      <a href={action.link} class={`btn ${action.type}`}>{action.text}</a>
                    ))}
                  </div>
                ) : null}
              </div>
            </section>
          )
        }
        {
          featuredMeta && (
            <article class={`surface featured-card mode-${featuredMode} fade-up`}>
              <div class="featured-meta">
                <p class="featured-label">Featured</p>
                <a class="featured-title" href={featuredLink}>{featuredMeta.title}</a>
                <p class="featured-summary">{(featuredMeta.summary || featuredMeta.description || "").trim()}</p>
                <footer class="featured-foot">
                  <div class="featured-tags">
                    {featuredMeta.tags.slice(0, 3).map((tag) => <span class="tag-badge">{tag}</span>)}
                  </div>
                  <time class="featured-date" datetime={featuredMeta.createTime.toISOString()}>
                    {formatDate(featuredMeta.createTime, "YYYY-MM-DD")}
                  </time>
                </footer>
              </div>
              {showFeaturedCover && (
                <a class="featured-cover" href={featuredLink} aria-label={featuredMeta.title}>
                  <ContentCover
                    title={featuredMeta.title}
                    image={featuredImageSources.src}
                    srcset={featuredImageSources.srcset}
                    sizes="(max-width: 900px) calc(100vw - 48px), (max-width: 1280px) 38vw, 420px"
                    kindLabel="精选文章"
                    topic={featuredMeta.tags[0]}
                    loading="eager"
                    fetchpriority="high"
                    variant="large"
                  />
                </a>
              )}
            </article>
          )
        }

        <div class="stream-head">
          <div class="stream-title">
            <p class="stream-kicker">Latest</p>
            <h2 class="section-title">最新文章</h2>
          </div>
          <a href="/archives">全部内容 →</a>
        </div>
        <div class="recent-grid" id="home-feed-list">
          {
            recentEntries.map((entry, idx) => (
              <div data-page-item hidden={idx >= pageSize ? true : undefined}>
                <PostCard entry={entry} kind={entry.collection === "blog" ? "blog" : "tutorial"} />
              </div>
            ))
          }
        </div>
        <nav class="surface pager-shell home-pager" id="home-feed-pager" hidden></nav>
        <div id="home-feed-sentinel" aria-hidden="true"></div>
      </section>

      <aside class="profile-rail home-side">
        <SidebarProfile />
      </aside>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ batchSize: pageSize, feedMode }}>
  const initHomeFeed = () => {
    const list = document.getElementById("home-feed-list");
    const pager = document.getElementById("home-feed-pager");
    const sentinel = document.getElementById("home-feed-sentinel");
    if (!(list instanceof HTMLElement) || !(sentinel instanceof HTMLElement)) return;

    if (window.__flyHomeFeedRoot === list && window.__flyHomeFeedCleanup) return;
    if (window.__flyHomeFeedCleanup) window.__flyHomeFeedCleanup();
    window.__flyHomeFeedRoot = list;

    const setCleanup = (cleanup) => {
      window.__flyHomeFeedCleanup = () => {
        cleanup();
        if (window.__flyHomeFeedRoot === list) {
          window.__flyHomeFeedRoot = null;
          window.__flyHomeFeedCleanup = null;
        }
      };
    };

    const items = Array.from(list.querySelectorAll("[data-page-item]"));
    if (items.length <= batchSize) {
      sentinel.hidden = true;
      if (pager instanceof HTMLElement) pager.hidden = true;
      setCleanup(() => {});
      return;
    }

    if (feedMode === "page") {
      let currentPage = 1;
      const totalPages = Math.max(1, Math.ceil(items.length / batchSize));

      const setPage = (page, syncQuery = true) => {
        currentPage = Math.max(1, Math.min(totalPages, page));
        const start = (currentPage - 1) * batchSize;
        const end = start + batchSize;
        items.forEach((item, idx) => item.toggleAttribute("hidden", idx < start || idx >= end));

        if (pager instanceof HTMLElement) {
          if (totalPages <= 1) {
            pager.hidden = true;
          } else {
            const windowPages = (current, total) => {
              if (total <= 7) return Array.from({ length: total }, (_, idx) => idx + 1);
              const picked = [...new Set([1, total, current - 1, current, current + 1])]
                .filter((page) => page >= 1 && page <= total)
                .sort((a, b) => a - b);
              const out = [];
              let prev = 0;
              for (const page of picked) {
                if (page - prev > 1) out.push("ellipsis");
                out.push(page);
                prev = page;
              }
              return out;
            };
            const pageHref = (pageNo) => {
              const url = new URL(window.location.href);
              if (pageNo <= 1) url.searchParams.delete("page");
              else url.searchParams.set("page", String(pageNo));
              return `${url.pathname}${url.search}${url.hash}`;
            };
            const pages = windowPages(currentPage, totalPages)
              .map((pageNo) => {
                if (pageNo === "ellipsis") return `<span class="pager-ellipsis" aria-hidden="true">…</span>`;
                const active = pageNo === currentPage ? "is-active" : "";
                return `<a class="pager-btn pager-btn-num ${active}" data-page="${pageNo}" data-astro-reload href="${pageHref(pageNo)}">${pageNo}</a>`;
              })
              .join("");
            pager.innerHTML = `
              ${currentPage <= 1
                ? '<span class="pager-btn is-disabled" aria-disabled="true">上一页</span>'
                : `<a class="pager-btn" data-page="${currentPage - 1}" data-astro-reload href="${pageHref(currentPage - 1)}">上一页</a>`}
              <div class="pager-pages">${pages}</div>
              ${currentPage >= totalPages
                ? '<span class="pager-btn is-disabled" aria-disabled="true">下一页</span>'
                : `<a class="pager-btn" data-page="${currentPage + 1}" data-astro-reload href="${pageHref(currentPage + 1)}">下一页</a>`}
            `;
            pager.hidden = false;
          }
        }

        if (syncQuery) {
          const url = new URL(window.location.href);
          if (currentPage <= 1) {
            url.searchParams.delete("page");
          } else {
            url.searchParams.set("page", String(currentPage));
          }
          window.history.replaceState({}, "", `${url.pathname}${url.search}${url.hash}`);
        }
      };

      const queryPage = Number.parseInt(new URLSearchParams(window.location.search).get("page") || "1", 10);
      setPage(Number.isFinite(queryPage) ? queryPage : 1, false);
      sentinel.hidden = true;

      const onPagerClick = (event) => {
        const target =
          event.target instanceof Element
            ? event.target
            : event.target instanceof Node
              ? event.target.parentElement
              : null;
        if (!(target instanceof Element)) return;
        const link = target.closest("a[data-page]");
        if (!(link instanceof HTMLAnchorElement)) return;
        const next = Number.parseInt(link.dataset.page || "1", 10);
        if (!Number.isFinite(next)) return;
        event.preventDefault();
        setPage(next);
      };

      if (pager instanceof HTMLElement) {
        pager.addEventListener("click", onPagerClick, true);
      }

      setCleanup(() => {
        if (pager instanceof HTMLElement) {
          pager.removeEventListener("click", onPagerClick, true);
        }
      });
      return;
    }

    const revealNext = () => {
      let revealed = 0;
      for (const item of items) {
        if (!item.hasAttribute("hidden")) continue;
        item.removeAttribute("hidden");
        revealed += 1;
        if (revealed >= batchSize) break;
      }
      const hasHidden = items.some((item) => item.hasAttribute("hidden"));
      sentinel.hidden = !hasHidden;
      return hasHidden;
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const hasMore = revealNext();
          if (!hasMore) observer.disconnect();
        }
      },
      { rootMargin: "260px 0px 360px 0px", threshold: 0.01 }
    );

    if (pager instanceof HTMLElement) pager.hidden = true;
    observer.observe(sentinel);
    sentinel.hidden = false;
    setCleanup(() => observer.disconnect());
  };

  if (!window.__flyHomeFeedPageLoadBound) {
    window.__flyHomeFeedPageLoadBound = true;
    document.addEventListener("astro:page-load", initHomeFeed);
  }
  initHomeFeed();
</script>

<style>
  .home-page {
    display: grid;
    gap: var(--space-6);
  }

  .hero {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    padding: clamp(2rem, 4vw, 3.4rem) clamp(1.4rem, 3.2vw, 2.8rem);
    border: 1px solid var(--line);
    background:
      radial-gradient(88% 150% at 100% 0%, color-mix(in oklab, var(--brand-soft) 42%, transparent 58%), transparent 60%),
      var(--surface-1);
    text-align: left;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.16;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 720px;
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(1.8rem, 1.8vw + 1.2rem, 2.4rem);
    line-height: 1.22;
    letter-spacing: 0;
    font-weight: 700;
  }

  .tagline {
    margin: 0;
    color: var(--text);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .description {
    margin: 0;
    color: var(--text-soft);
    max-width: 62ch;
    line-height: 1.75;
    font-size: 1.01rem;
  }

  .hero-metrics {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: var(--space-1);
  }

  .hero-metrics .chip {
    font-size: 0.75rem;
    padding: 0.18rem 0.56rem;
  }

  .hero-actions {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .btn {
    border-radius: var(--radius-pill);
    padding: 0.62rem 1.1rem;
    font-size: 0.9rem;
    font-weight: 600;
    border: 1px solid var(--line);
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .btn.primary {
    color: color-mix(in oklab, var(--bg) 86%, #ffffff 14%);
    border-color: color-mix(in oklab, var(--brand) 54%, var(--line) 46%);
    background: linear-gradient(
      140deg,
      color-mix(in oklab, var(--brand) 88%, white 12%),
      color-mix(in oklab, var(--accent) 46%, var(--brand) 54%)
    );
  }

  .btn.secondary {
    background: color-mix(in oklab, var(--surface-1) 86%, transparent 14%);
    color: var(--text);
  }

  .btn:hover {
    border-color: color-mix(in oklab, var(--brand) 58%, var(--line) 42%);
    color: var(--brand);
  }

  .home-main {
    display: grid;
    gap: var(--space-4);
  }

  .featured-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 42%);
    gap: var(--space-4);
    padding: var(--space-3);
    align-items: stretch;
  }

  .featured-card.mode-left {
    grid-template-columns: minmax(240px, 42%) minmax(0, 1fr);
  }

  .featured-card.mode-top {
    grid-template-columns: 1fr;
  }

  .featured-card.mode-none {
    grid-template-columns: 1fr;
  }

  .featured-cover {
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--line);
    display: block;
    background: color-mix(in oklab, var(--brand-soft) 56%, var(--surface-2) 44%);
    height: 100%;
  }

  .featured-card.mode-right .featured-cover {
    order: 2;
  }

  .featured-card.mode-left .featured-cover {
    order: 1;
  }

  .featured-card.mode-left .featured-meta {
    order: 2;
  }

  .featured-card.mode-top .featured-cover {
    aspect-ratio: auto;
    height: clamp(180px, 28vw, 248px);
  }

  .featured-card.mode-top .featured-meta {
    order: 2;
  }

  .featured-meta {
    display: grid;
    align-content: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .featured-label {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand);
    font-weight: 650;
  }

  .featured-title {
    margin: 0;
    font-size: clamp(1.2rem, 0.72vw + 0.98rem, 1.56rem);
    line-height: 1.26;
    letter-spacing: 0;
    font-weight: 700;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-summary {
    margin: 0;
    color: var(--text-soft);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .featured-tags {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .featured-tags .tag-badge {
    font-size: 0.72rem;
    padding: 0.2rem 0.56rem;
  }

  .featured-date {
    color: var(--text-muted);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .stream-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--line);
  }

  .stream-title {
    display: grid;
    gap: 0.18rem;
  }

  .stream-kicker {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brand);
  }

  .stream-title .section-title {
    position: relative;
    padding-left: 0.7rem;
    font-size: clamp(1.15rem, 0.9vw + 1rem, 1.4rem);
  }

  .stream-title .section-title::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.18em;
    bottom: 0.18em;
    width: 3px;
    border-radius: 999px;
    background: var(--brand);
  }

  .stream-head a {
    color: var(--brand);
    font-size: 0.88rem;
    font-weight: 600;
    transition: transform 200ms var(--ease-out-soft), color 200ms ease;
  }

  .stream-head a:hover {
    transform: translateX(2px);
  }

  .recent-grid {
    display: grid;
    gap: var(--space-4);
  }

  .home-pager {
    margin-top: 0.15rem;
  }

  #home-feed-sentinel {
    width: 100%;
    height: 2px;
  }

  .side-panel {
    padding: var(--space-3);
    border-radius: var(--radius-md);
    display: grid;
    gap: var(--space-3);
  }

  .side-panel header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .side-panel h3 {
    margin: 0;
    font-size: 0.94rem;
  }

  .side-panel a {
    font-size: 0.82rem;
    color: var(--brand);
  }

  .side-panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }

  .side-panel li a {
    color: var(--text-soft);
    line-height: 1.5;
    font-size: 0.88rem;
  }

  .side-panel li a:hover {
    color: var(--text);
  }

  @media (max-width: 1120px) {
    .featured-card.mode-right,
    .featured-card.mode-left {
      grid-template-columns: 1fr;
    }

    .featured-card .featured-cover {
      order: 1;
      aspect-ratio: auto;
      height: clamp(180px, 30vw, 230px);
    }

    .featured-card .featured-meta {
      order: 2;
    }
  }

  @media (max-width: 1024px) {
  }

  @media (max-width: 760px) {
    .hero {
      padding: var(--space-4) var(--space-3);
    }

    .hero h1 {
      font-size: clamp(1.5rem, 6vw, 1.9rem);
      overflow-wrap: anywhere;
    }

    .tagline {
      font-size: 0.98rem;
    }

    .description {
      font-size: 0.92rem;
      line-height: 1.65;
    }

    .hero-actions .btn {
      padding: 0.5rem 0.9rem;
      font-size: 0.84rem;
    }
  }
</style>

