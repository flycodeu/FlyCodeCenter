---
import siteConfig from "@/site.config";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { fetchReadingEntries } from "@/utils/query";
import { formatDate } from "@/utils/date";
import { getTagColorVars } from "@/utils/tag-color";

const entries = await fetchReadingEntries();

const tagMap = new Map<string, number>();
for (const entry of entries) {
  for (const tag of entry.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
  }
}

const tags = [...tagMap.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));

const getHost = (url?: string) => {
  if (!url) return "";
  try {
    return new URL(url).host.replace(/^www\./, "");
  } catch {
    return "";
  }
};
---

<BaseLayout title={siteConfig.pages.reading.title} description="沉淀有深度、有参考价值的技术好文与工程架构实战。">
  <div class="reading-page-root">
    <section class="reading-shell">
      <header class="reading-header">
        <div class="header-left">
          <h1 class="page-title">{siteConfig.pages.reading.title}</h1>
          <p class="page-desc">精选业内值得反复研读的工程实践、系统架构与深度技术好文。</p>
        </div>
        <div class="header-count-badge">
          共收录 <strong>{entries.length}</strong> 篇精选
        </div>
      </header>

      <nav class="reading-filter-bar" id="reading-filter" aria-label="文章标签筛选">
        <button type="button" class="tag-chip active" data-tag="all">
          <span class="chip-label">全部</span>
          <small class="chip-count">{entries.length}</small>
        </button>
        {
          tags.map((tag) => (
            <button type="button" class="tag-chip" data-tag={tag.name} style={getTagColorVars(tag.name)}>
              <span class="chip-label">{tag.name}</span>
              <small class="chip-count">{tag.count}</small>
            </button>
          ))
        }
      </nav>

      <section class="reading-grid" id="reading-grid">
        {
          entries.map((entry) => {
            const hasUrl = Boolean(entry.data.url);
            const CardTag = hasUrl ? "a" : "div";
            return (
              <CardTag
                class="reading-card surface"
                href={entry.data.url || undefined}
                target={hasUrl ? "_blank" : undefined}
                rel={hasUrl ? "noreferrer" : undefined}
                data-item
                data-tags={entry.data.tags.map((tag) => tag.toLowerCase().trim()).join("||")}
                title={hasUrl ? `访问 ${entry.data.title}` : undefined}
              >
                <header class="card-head">
                  <div class="source-info">
                    <span class="source-pill">{entry.data.source || (entry.data.url ? getHost(entry.data.url) : "精选")}</span>
                    {entry.data.url && (
                      <>
                        <span class="meta-dot" aria-hidden="true">·</span>
                        <span class="host-name">{getHost(entry.data.url)}</span>
                      </>
                    )}
                  </div>
                  <time class="card-date" datetime={entry.data.pubDate ? new Date(entry.data.pubDate).toISOString() : undefined}>
                    {formatDate(entry.data.pubDate)}
                  </time>
                </header>

                <div class="card-main">
                  <div class="card-title-line">
                    <h2 class="card-title">{entry.data.title}</h2>
                    {hasUrl && <span class="external-icon" aria-hidden="true">↗</span>}
                  </div>
                  <p class="card-summary">{entry.data.description || "暂无导读摘要"}</p>
                </div>

                <footer class="card-footer">
                  <div class="tag-list" aria-label="技术标签">
                    {entry.data.tags.map((tag) => (
                      <span class="meta-tag tag-badge" style={getTagColorVars(tag)}>{tag}</span>
                    ))}
                  </div>
                </footer>
              </CardTag>
            );
          })
        }
      </section>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  const initReadingFilter = () => {
    const filter = document.getElementById('reading-filter');
    const grid = document.getElementById('reading-grid');
    if (!filter || !grid) return;

    if (window.__flyReadingFilterRoot === grid && window.__flyReadingFilterCleanup) return;
    if (window.__flyReadingFilterCleanup) {
      window.__flyReadingFilterCleanup();
    }
    window.__flyReadingFilterRoot = grid;

    const controller = new AbortController();
    const { signal } = controller;

    const buttons = Array.from(filter.querySelectorAll('.tag-chip'));
    const items = Array.from(grid.querySelectorAll('[data-item]'));
    const normalize = (value) => String(value || '').trim().toLowerCase();

    const applyFilter = (rawTag, syncQuery = true) => {
      const activeTag = normalize(rawTag || 'all');

      buttons.forEach((button) => {
        button.classList.toggle('active', normalize(button.dataset.tag) === activeTag);
      });

      items.forEach((item) => {
        const tagsText = item.getAttribute('data-tags') || '';
        const set = tagsText ? tagsText.split('||').map(normalize) : [];
        const visible = activeTag === 'all' || set.includes(activeTag);
        item.toggleAttribute('hidden', !visible);
      });

      if (syncQuery) {
        const url = new URL(window.location.href);
        if (activeTag === 'all') {
          url.searchParams.delete('tag');
        } else {
          const activeButton = buttons.find((button) => normalize(button.dataset.tag) === activeTag);
          if (activeButton?.dataset.tag) {
            url.searchParams.set('tag', activeButton.dataset.tag);
          }
        }
        window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
      }
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        applyFilter(button.dataset.tag || 'all');
      }, { signal });
    });

    const queryTag = new URLSearchParams(window.location.search).get('tag');
    if (queryTag) {
      const match = buttons.find((button) => normalize(button.dataset.tag) === normalize(queryTag));
      applyFilter(match?.dataset.tag || 'all', false);
    } else {
      applyFilter('all', false);
    }

    window.__flyReadingFilterCleanup = () => {
      controller.abort();
      if (window.__flyReadingFilterRoot === grid) {
        window.__flyReadingFilterRoot = null;
        window.__flyReadingFilterCleanup = null;
      }
    };
  };

  if (!window.__flyReadingFilterPageLoadBound) {
    window.__flyReadingFilterPageLoadBound = true;
    document.addEventListener('astro:page-load', initReadingFilter);
  }
  initReadingFilter();
</script>

<style is:global>
  .reading-page-root {
    width: 100%;
  }

  .reading-shell {
    display: grid;
    gap: 1.5rem;
  }

  .reading-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 0.8rem 0.2rem 1.2rem;
    border-bottom: 1px solid color-mix(in oklab, var(--line) 75%, transparent 25%);
  }

  .reading-header .header-left {
    display: grid;
    gap: 0.35rem;
  }

  .reading-header .page-title {
    margin: 0;
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.015em;
  }

  .reading-header .page-desc {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .reading-header .header-count-badge {
    border: 1px solid color-mix(in oklab, var(--line) 80%, transparent 20%);
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    background: color-mix(in oklab, var(--surface-2) 75%, transparent 25%);
    white-space: nowrap;
    align-self: flex-end;
  }

  .reading-header .header-count-badge strong {
    color: var(--brand);
    font-family: var(--font-tech);
  }

  .reading-filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0;
  }

  .tag-chip {
    border: 1px solid color-mix(in oklab, var(--line) 80%, transparent 20%);
    background: color-mix(in oklab, var(--surface-2) 75%, transparent 25%);
    color: var(--text-soft);
    border-radius: 999px;
    padding: 0.26rem 0.68rem;
    font-size: 0.8rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    cursor: pointer;
    transition: all 140ms ease;
  }

  .tag-chip:hover {
    color: var(--brand);
    border-color: color-mix(in oklab, var(--brand) 40%, var(--line) 60%);
    background: color-mix(in oklab, var(--brand-soft) 40%, var(--bg-elev) 60%);
    transform: translateY(-1px);
  }

  .chip-count {
    border: 1px solid color-mix(in oklab, var(--line) 75%, transparent 25%);
    border-radius: 999px;
    padding: 0.02rem 0.36rem;
    font-size: 0.68rem;
    font-family: var(--font-tech);
    background: color-mix(in oklab, var(--bg) 90%, transparent 10%);
    color: var(--text-muted);
  }

  .tag-chip.active {
    background: var(--brand) !important;
    color: #fff !important;
    border-color: var(--brand) !important;
    box-shadow: 0 4px 12px -3px var(--brand);
    transform: translateY(-1px);
  }

  .tag-chip.active .chip-count {
    background: rgb(255 255 255 / 0.22);
    color: #fff;
    border-color: transparent;
  }

  .reading-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .reading-card {
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in oklab, var(--line) 82%, transparent 18%);
    background: color-mix(in oklab, var(--surface-1) 95%, transparent 5%);
    padding: 1.25rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    text-decoration: none;
    transition: all 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reading-card:hover {
    border-color: color-mix(in oklab, var(--brand) 38%, var(--line) 62%);
    background: color-mix(in oklab, var(--surface-2) 65%, transparent 35%);
    box-shadow: 0 8px 20px -8px color-mix(in oklab, var(--brand) 22%, transparent 78%);
    transform: translateY(-2px);
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    font-size: 0.74rem;
  }

  .source-info {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    min-width: 0;
  }

  .source-pill {
    color: var(--brand);
    font-weight: 600;
    font-family: var(--font-tech);
    background: color-mix(in oklab, var(--brand-soft) 42%, var(--bg-elev) 58%);
    padding: 0.08rem 0.46rem;
    border-radius: 4px;
    border: 1px solid color-mix(in oklab, var(--brand) 25%, var(--line) 75%);
    white-space: nowrap;
  }

  .meta-dot {
    color: var(--text-muted);
    opacity: 0.6;
  }

  .host-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 180px;
    font-family: var(--font-tech);
    color: var(--text-muted);
  }

  .card-date {
    color: var(--text-muted);
    font-family: var(--font-tech);
    font-size: 0.72rem;
    white-space: nowrap;
    flex: 0 0 auto;
  }

  .card-main {
    display: grid;
    gap: 0.4rem;
    flex: 1;
  }

  .card-title-line {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .card-title {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text);
    transition: color 140ms ease;
  }

  .reading-card:hover .card-title {
    color: var(--brand);
  }

  .external-icon {
    color: var(--text-muted);
    font-size: 0.95rem;
    transition: all 140ms ease;
    opacity: 0.65;
    flex: 0 0 auto;
    margin-top: 0.1rem;
  }

  .reading-card:hover .external-icon {
    color: var(--brand);
    opacity: 1;
    transform: translate(2px, -2px);
  }

  .card-summary {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.85rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-top: 0.35rem;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    min-width: 0;
  }

  .meta-tag {
    font-size: 0.68rem;
    padding: 0.05rem 0.38rem;
    border-radius: 5px;
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .reading-grid {
      grid-template-columns: 1fr;
    }

    .reading-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }
  }
</style>
