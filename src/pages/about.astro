---
import BaseLayout from "@/layouts/BaseLayout.astro";
import siteConfig from "@/site.config";
import Comments from "@/components/Comments.astro";
import { fetchProjectEntries } from "@/utils/query";
import { resolveArticleMeta } from "@/utils/article-meta";
import { getProjectEntryUrl } from "@/utils/content";
import { getRenderedPageByCode } from "@/utils/page-content";

const [aboutPage, projectEntries] = await Promise.all([
  getRenderedPageByCode("about-page"),
  fetchProjectEntries()
]);

if (!aboutPage) {
  throw new Error("Page config not found: about-page");
}

const aboutConfig = aboutPage.entry.data.about;
if (!aboutConfig) {
  throw new Error("About config not found: about-page.about");
}

const hero = aboutConfig.hero;
const intro = (aboutConfig as { intro?: { direction: { title: string; paragraphs: string[] }; focus: { title: string; items: string[] }; goal: string } }).intro;
const blogIntro = (aboutConfig as { blogIntro?: { title: string; lead: string; topics: string[]; hope: string } }).blogIntro;
const showcase = aboutConfig.showcase;
const gaming = aboutConfig.gaming;
const linkLabels = showcase.labels;

const projectMap = new Map(
  projectEntries.map((entry) => {
    const meta = resolveArticleMeta(entry);
    return [meta.code, { entry, meta }] as const;
  })
);

const selectedCards = showcase.projectCodes
  .map((code) => projectMap.get(code))
  .filter((item): item is NonNullable<typeof item> => Boolean(item));

const fallbackCards = [...projectMap.values()]
  .filter((item) => item.meta.projectStage === "completed" && item.meta.featured)
  .sort((a, b) => b.meta.priority - a.meta.priority)
  .slice(0, 3);

const cards = selectedCards.length > 0 ? selectedCards : fallbackCards;
const AboutContent = aboutPage.Content;
const aboutCommentsEnabled =
  ((siteConfig.pages as { about?: { comments?: { enable?: boolean } } }).about?.comments?.enable ?? true) &&
  siteConfig.comment.provider !== "off";

const avatarUrl = siteConfig.profile?.avatar || "https://avatars.githubusercontent.com/flycodeu";
const developerName = siteConfig.profile?.name || "程序员飞云";
---

<BaseLayout title={aboutPage.entry.data.title} description={aboutPage.entry.data.description}>
  <div class="about-layout">
    <div class="about-grid">
      <!-- 主内容栏 (Left / Main Column) -->
      <main class="about-main">
        <!-- 1. 个人概述卡片 -->
        <section class="surface about-panel intro-panel">
          <div class="intro-header">
            <img
              src={avatarUrl}
              alt={developerName}
              class="intro-avatar"
              width="80"
              height="80"
              loading="eager"
              decoding="async"
            />
            <div class="intro-meta">
              <h1 class="intro-name">{hero.title || aboutPage.entry.data.title}</h1>
              <p class="intro-role">{hero.subtitle}</p>
              <div class="intro-links">
                <a href="https://github.com/flycodeu" target="_blank" rel="noreferrer" class="intro-link">
                  GitHub
                </a>
                <span class="divider">·</span>
                <a href="/blog" class="intro-link">技术博客</a>
                <span class="divider">·</span>
                <a href="/tutorials" class="intro-link">专栏教程</a>
              </div>
            </div>
          </div>
          <p class="intro-bio">
            专注于企业级后端高并发架构、工业视觉工程化落地与视频智能分析。在业务系统、流媒体传输与算法调度之间构建稳定可靠的工程闭环。
          </p>
        </section>

        <!-- 2. 核心技术方向与工程实践 -->
        {intro && (
          <section class="surface about-panel practice-panel">
            {intro.direction.paragraphs.length > 0 && (
              <div class="practice-block">
                <h2 class="panel-heading">{intro.direction.title}</h2>
                <div class="practice-text-group">
                  {intro.direction.paragraphs.map((p) => (
                    <p class="practice-desc">{p}</p>
                  ))}
                </div>
              </div>
            )}

            {intro.focus.items.length > 0 && (
              <div class="practice-block">
                <h2 class="panel-heading">{intro.focus.title}</h2>
                <ul class="practice-list">
                  {intro.focus.items.map((item) => (
                    <li>
                      <span class="list-bullet" aria-hidden="true"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {intro.goal && (
              <div class="goal-callout">
                <p class="goal-text">{intro.goal}</p>
              </div>
            )}
          </section>
        )}

        <!-- 3. 已完成项目展示 -->
        <section class="surface about-panel showcase-panel">
          <header class="panel-header-row">
            <h2 class="panel-heading">{showcase.title}</h2>
            <a href="/projects" class="panel-more-link">全部项目 →</a>
          </header>

          {cards.length === 0 ? (
            <p class="empty-note">{showcase.emptyText}</p>
          ) : (
            <div class="projects-list">
              {cards.map(({ entry, meta }) => (
                <article class="project-card-item">
                  {meta.cover && (
                    <a href={getProjectEntryUrl(entry)} class="project-thumb-link" tabindex="-1" aria-hidden="true">
                      <img
                        class="project-thumb"
                        src={meta.cover}
                        alt={meta.title}
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                      />
                    </a>
                  )}
                  <div class="project-info">
                    <div class="project-head">
                      <h3 class="project-title">
                        <a href={getProjectEntryUrl(entry)}>{meta.title}</a>
                      </h3>
                      {meta.tags && meta.tags[0] && (
                        <span class="project-tag">{meta.tags[0]}</span>
                      )}
                    </div>
                    <p class="project-desc">{meta.description || meta.summary || linkLabels.noDescription}</p>
                    <div class="project-actions">
                      {meta.repoUrl && (
                        <a href={meta.repoUrl} target="_blank" rel="noreferrer" class="action-link">
                          {linkLabels.repo}
                        </a>
                      )}
                      {meta.demoUrl && (
                        <a href={meta.demoUrl} target="_blank" rel="noreferrer" class="action-link highlight">
                          {linkLabels.demo}
                        </a>
                      )}
                      <a href={getProjectEntryUrl(entry)} class="action-link detail">
                        {linkLabels.detail} →
                      </a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          )}
        </section>

        <!-- 4. 正文手记与感悟 -->
        <section class="surface about-panel prose-panel">
          <div class="prose">
            <AboutContent />
          </div>
        </section>

        {aboutCommentsEnabled && <Comments />}
      </main>

      <!-- 侧边栏 (Right / Sidebar Column) -->
      <aside class="about-sidebar">
        <!-- 侧栏 1: 技术栈全景 -->
        <section class="surface sidebar-card">
          <h2 class="sidebar-heading">技术栈与工具箱</h2>
          <div class="stack-group">
            <span class="stack-label">后端架构与服务</span>
            <div class="tags-cluster">
              <span class="tag-badge highlight">Java 17/21</span>
              <span class="tag-badge highlight">Spring Boot 3</span>
              <span class="tag-badge">MySQL</span>
              <span class="tag-badge">Redis</span>
              <span class="tag-badge">Oracle</span>
              <span class="tag-badge">Docker</span>
            </div>
          </div>

          <div class="stack-group">
            <span class="stack-label">工业视觉与 AI 实践</span>
            <div class="tags-cluster">
              <span class="tag-badge highlight">YOLO 目标检测</span>
              <span class="tag-badge highlight">PyTorch</span>
              <span class="tag-badge">OpenCV</span>
              <span class="tag-badge">MediaMTX</span>
              <span class="tag-badge">WebRTC</span>
              <span class="tag-badge">FFmpeg</span>
            </div>
          </div>

          <div class="stack-group">
            <span class="stack-label">全栈与工程化</span>
            <div class="tags-cluster">
              <span class="tag-badge">Vue 3 / React</span>
              <span class="tag-badge">TypeScript</span>
              <span class="tag-badge">Python</span>
              <span class="tag-badge">Node.js</span>
              <span class="tag-badge">Linux</span>
            </div>
          </div>
        </section>

        <!-- 侧栏 2: 关于博客初衷 -->
        {blogIntro && (
          <section class="surface sidebar-card">
            <h2 class="sidebar-heading">{blogIntro.title}</h2>
            {blogIntro.lead && <p class="sidebar-text">{blogIntro.lead}</p>}
            {blogIntro.topics.length > 0 && (
              <div class="topics-wrap">
                <span class="stack-label">沉淀领域</span>
                <ul class="topic-list">
                  {blogIntro.topics.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </div>
            )}
            {blogIntro.hope && <p class="sidebar-note">{blogIntro.hope}</p>}
          </section>
        )}

        <!-- 侧栏 3: 玩家档案 -->
        <section class="surface sidebar-card">
          <h2 class="sidebar-heading">{gaming.title}</h2>
          <div class="gaming-cluster">
            {gaming.groups.map((group) => (
              <div class="game-group-item">
                <span class="game-group-name">{group.name}</span>
                <div class="game-tags-flow">
                  {group.games.map((game) => (
                    <span class="game-pill">{game}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* 整体双栏容器：居中、限制最大宽度、留白匀称 */
  .about-layout {
    width: 100%;
    margin: 0 auto;
    padding: clamp(0.5rem, 1.5vw, 1.5rem) 0 3.5rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 1.75rem;
    align-items: start;
  }

  /* 基础面板：统一度量、浅线框与内边距 */
  .about-panel {
    padding: clamp(1.2rem, 2vw, 1.6rem);
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
    border: 1px solid color-mix(in oklab, var(--line) 80%, transparent 20%);
    background: var(--surface-1);
  }

  /* 1. 个人概述卡片 */
  .intro-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid color-mix(in oklab, var(--line) 65%, transparent 35%);
  }

  .intro-avatar {
    width: 76px;
    height: 76px;
    border-radius: 14px;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid color-mix(in oklab, var(--line) 85%, transparent 15%);
    background: var(--surface-2);
  }

  .intro-meta {
    display: grid;
    gap: 0.35rem;
  }

  .intro-name {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--text);
  }

  .intro-role {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-soft);
    line-height: 1.4;
  }

  .intro-links {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    margin-top: 0.15rem;
  }

  .intro-link {
    color: var(--brand);
    text-decoration: none;
    font-weight: 500;
  }

  .intro-link:hover {
    text-decoration: underline;
  }

  .divider {
    color: var(--text-muted);
  }

  .intro-bio {
    margin: 1.1rem 0 0;
    font-size: 0.9rem;
    line-height: 1.82;
    color: var(--text-soft);
  }

  /* 2. 深度实践面板 */
  .practice-panel {
    display: grid;
    gap: 1.5rem;
  }

  .panel-heading {
    margin: 0 0 0.85rem;
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--text);
    padding-left: 0.65rem;
    border-left: 3px solid var(--brand);
    line-height: 1.2;
  }

  .practice-text-group {
    display: grid;
    gap: 0.65rem;
  }

  .practice-desc {
    margin: 0;
    font-size: 0.89rem;
    line-height: 1.8;
    color: var(--text-soft);
  }

  .practice-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .practice-list li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.88rem;
    line-height: 1.68;
    color: var(--text-soft);
  }

  .list-bullet {
    width: 4px;
    height: 4px;
    background: var(--brand);
    border-radius: 1px;
    transform: rotate(45deg);
    flex-shrink: 0;
    align-self: center;
  }

  .goal-callout {
    padding: 0.9rem 1.1rem;
    border-radius: 6px;
    background: color-mix(in oklab, var(--brand) 6%, var(--surface-2) 94%);
    border: 1px solid color-mix(in oklab, var(--brand) 20%, transparent);
  }

  .goal-text {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.78;
    color: var(--text);
  }

  /* 3. 已完成项目展示 */
  .panel-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.1rem;
  }

  .panel-header-row .panel-heading {
    margin-bottom: 0;
  }

  .panel-more-link {
    font-size: 0.8rem;
    color: var(--brand);
    text-decoration: none;
    font-weight: 500;
  }

  .panel-more-link:hover {
    text-decoration: underline;
  }

  .projects-list {
    display: grid;
    gap: 1.15rem;
  }

  .project-card-item {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 1.1rem;
    padding: 0.85rem;
    border-radius: 8px;
    background: color-mix(in oklab, var(--surface-2) 40%, var(--surface-1) 60%);
    border: 1px solid color-mix(in oklab, var(--line) 75%, transparent 25%);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .project-card-item:hover {
    border-color: color-mix(in oklab, var(--brand) 40%, var(--line) 60%);
  }

  .project-thumb-link {
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    overflow: hidden;
    background: var(--surface-2);
    border: 1px solid color-mix(in oklab, var(--line) 60%, transparent 40%);
  }

  .project-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-info {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.45rem;
  }

  .project-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .project-title {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .project-title a {
    color: var(--text);
    text-decoration: none;
  }

  .project-title a:hover {
    color: var(--brand);
  }

  .project-tag {
    font-size: 0.7rem;
    padding: 0.12rem 0.45rem;
    border-radius: 4px;
    background: color-mix(in oklab, var(--surface-2) 90%, transparent 10%);
    color: var(--text-muted);
    border: 1px solid color-mix(in oklab, var(--line) 70%, transparent 30%);
    white-space: nowrap;
  }

  .project-desc {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--text-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: 0.78rem;
    padding-top: 0.2rem;
  }

  .action-link {
    color: var(--text-soft);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .action-link:hover {
    color: var(--brand);
  }

  .action-link.highlight {
    color: var(--brand);
    font-weight: 500;
  }

  .action-link.detail {
    margin-left: auto;
    color: var(--brand);
    font-weight: 500;
  }

  /* 4. 正文手记 */
  .prose-panel .prose {
    font-size: 0.9rem;
    line-height: 1.82;
    color: var(--text-soft);
  }

  /* 侧栏卡片 (Sidebar Cards) */
  .sidebar-card {
    padding: 1.2rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.25rem;
    border: 1px solid color-mix(in oklab, var(--line) 80%, transparent 20%);
    background: var(--surface-1);
    display: grid;
    gap: 1.05rem;
  }

  .sidebar-heading {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 650;
    color: var(--text);
    padding-bottom: 0.55rem;
    border-bottom: 1px solid color-mix(in oklab, var(--line) 60%, transparent 40%);
  }

  .stack-group {
    display: grid;
    gap: 0.45rem;
  }

  .stack-label {
    font-size: 0.74rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .tags-cluster {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag-badge {
    font-size: 0.75rem;
    padding: 0.18rem 0.5rem;
    border-radius: 5px;
    background: color-mix(in oklab, var(--surface-2) 75%, transparent 25%);
    border: 1px solid color-mix(in oklab, var(--line) 75%, transparent 25%);
    color: var(--text-soft);
  }

  .tag-badge.highlight {
    color: var(--brand);
    border-color: color-mix(in oklab, var(--brand) 30%, var(--line) 70%);
    background: color-mix(in oklab, var(--brand) 8%, var(--surface-2) 92%);
    font-weight: 500;
  }

  .sidebar-text {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.72;
    color: var(--text-soft);
  }

  .topics-wrap {
    display: grid;
    gap: 0.45rem;
  }

  .topic-list {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--text-soft);
  }

  .sidebar-note {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-muted);
    border-top: 1px dashed color-mix(in oklab, var(--line) 60%, transparent 40%);
    padding-top: 0.65rem;
  }

  .gaming-cluster {
    display: grid;
    gap: 0.85rem;
  }

  .game-group-item {
    display: grid;
    gap: 0.35rem;
  }

  .game-group-name {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .game-tags-flow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .game-pill {
    font-size: 0.74rem;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: color-mix(in oklab, var(--surface-2) 75%, transparent 25%);
    border: 1px solid color-mix(in oklab, var(--line) 65%, transparent 35%);
    color: var(--text-soft);
  }

  .empty-note {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  /* 响应式断点适配 */
  @media (max-width: 880px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .project-card-item {
      grid-template-columns: 1fr;
    }

    .project-thumb-link {
      max-height: 200px;
    }
  }
</style>
