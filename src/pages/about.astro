---
import BaseLayout from "@/layouts/BaseLayout.astro";
import siteConfig from "@/site.config";
import Comments from "@/components/Comments.astro";
import { fetchProjectEntries } from "@/utils/query";
import { resolveArticleMeta } from "@/utils/article-meta";
import { getProjectEntryUrl } from "@/utils/content";
import { getRenderedPageByCode } from "@/utils/page-content";

const [aboutPage, projectEntries] = await Promise.all([
  getRenderedPageByCode("about-page"),
  fetchProjectEntries()
]);

if (!aboutPage) {
  throw new Error("Page config not found: about-page");
}

const aboutConfig = aboutPage.entry.data.about;
if (!aboutConfig) {
  throw new Error("About config not found: about-page.about");
}

const hero = aboutConfig.hero;
const intro = (aboutConfig as { intro?: { direction: { title: string; paragraphs: string[] }; focus: { title: string; items: string[] }; goal: string } }).intro;
const blogIntro = (aboutConfig as { blogIntro?: { title: string; lead: string; topics: string[]; hope: string } }).blogIntro;
const showcase = aboutConfig.showcase;
const gaming = aboutConfig.gaming;
const linkLabels = showcase.labels;

const projectMap = new Map(
  projectEntries.map((entry) => {
    const meta = resolveArticleMeta(entry);
    return [meta.code, { entry, meta }] as const;
  })
);

const selectedCards = showcase.projectCodes
  .map((code) => projectMap.get(code))
  .filter((item): item is NonNullable<typeof item> => Boolean(item));

const fallbackCards = [...projectMap.values()]
  .filter((item) => item.meta.projectStage === "completed" && item.meta.featured)
  .sort((a, b) => b.meta.priority - a.meta.priority)
  .slice(0, 3);

const cards = selectedCards.length > 0 ? selectedCards : fallbackCards;
const AboutContent = aboutPage.Content;
const aboutCommentsEnabled =
  ((siteConfig.pages as { about?: { comments?: { enable?: boolean } } }).about?.comments?.enable ?? true) &&
  siteConfig.comment.provider !== "off";
---

<BaseLayout title={aboutPage.entry.data.title} description={aboutPage.entry.data.description}>
  <div class="about-page">
    <header class="surface hero-panel">
      {hero.badge && <p class="hero-kicker">{hero.badge}</p>}
      <h1>{hero.title || aboutPage.entry.data.title}</h1>
      {hero.subtitle && <p class="hero-subtitle">{hero.subtitle}</p>}
      {hero.chips.length > 0 && (
        <div class="tech-chips">
          {hero.chips.map((chip) => (
            <span class="chip tech-chip">{chip}</span>
          ))}
        </div>
      )}
    </header>

    {intro && (intro.direction.paragraphs.length > 0 || intro.focus.items.length > 0) && (
      <section class="intro-grid">
        {intro.direction.paragraphs.length > 0 && (
          <article class="surface intro-card">
            <h2 class="block-title">{intro.direction.title}</h2>
            {intro.direction.paragraphs.map((paragraph) => (
              <p class="intro-paragraph">{paragraph}</p>
            ))}
          </article>
        )}
        {intro.focus.items.length > 0 && (
          <article class="surface intro-card">
            <h2 class="block-title">{intro.focus.title}</h2>
            <ul class="focus-list">
              {intro.focus.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        )}
      </section>
    )}

    {intro?.goal && (
      <aside class="surface goal-band">
        <p>{intro.goal}</p>
      </aside>
    )}

    <section class="about-section">
      <h2 class="section-heading">{showcase.title}</h2>
      {cards.length === 0 ? (
        <p class="empty-note">{showcase.emptyText}</p>
      ) : (
        <div class="showcase-grid">
          {cards.map(({ entry, meta }) => (
            <article class="surface showcase-card">
              {meta.cover && <img class="cover" src={meta.cover} alt={meta.title} loading="lazy" decoding="async" />}
              <h3>{meta.title}</h3>
              <p>{meta.description || meta.summary || linkLabels.noDescription}</p>
              <div class="links">
                {meta.repoUrl && <a href={meta.repoUrl} target="_blank" rel="noreferrer">{linkLabels.repo}</a>}
                {meta.docUrl && <a href={meta.docUrl} target="_blank" rel="noreferrer">{linkLabels.doc}</a>}
                {meta.demoUrl && <a href={meta.demoUrl} target="_blank" rel="noreferrer">{linkLabels.demo}</a>}
                <a href={getProjectEntryUrl(entry)}>{linkLabels.detail}</a>
              </div>
            </article>
          ))}
        </div>
      )}
    </section>

    {blogIntro && (blogIntro.lead || blogIntro.topics.length > 0) && (
      <section class="surface blog-panel">
        <h2 class="block-title">{blogIntro.title}</h2>
        {blogIntro.lead && <p class="blog-lead">{blogIntro.lead}</p>}
        {blogIntro.topics.length > 0 && (
          <ul class="topic-grid">
            {blogIntro.topics.map((topic) => (
              <li>{topic}</li>
            ))}
          </ul>
        )}
        {blogIntro.hope && <p class="blog-hope">{blogIntro.hope}</p>}
      </section>
    )}

    <section class="about-section">
      <h2 class="section-heading">{gaming.title}</h2>
      <div class="gaming-grid">
        {gaming.groups.map((group) => (
          <article class="surface game-group">
            <h3>{group.name}</h3>
            <div class="game-tags">
              {group.games.map((game) => (
                <span class="chip game-chip">{game}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="prose narrative">
      <AboutContent />
    </section>

    {aboutCommentsEnabled && <Comments />}
  </div>
</BaseLayout>

<style>
  .about-page {
    max-width: 920px;
    margin: 0 auto;
    display: grid;
    gap: var(--space-5);
  }

  .hero-panel {
    padding: clamp(1.8rem, 3.4vw, 2.8rem);
    display: grid;
    gap: var(--space-2);
    background:
      radial-gradient(88% 150% at 100% 0%, color-mix(in oklab, var(--brand-soft) 40%, transparent 60%), transparent 62%),
      var(--surface-1);
  }

  .hero-kicker {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brand);
  }

  .hero-panel h1 {
    margin: 0;
    font-size: clamp(1.6rem, 2.4vw, 2.2rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    margin: 0;
    color: var(--text-soft);
    line-height: 1.75;
    max-width: 46em;
  }

  .tech-chips {
    margin-top: var(--space-1);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tech-chip {
    font-size: 0.78rem;
    padding: 0.32rem 0.7rem;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-4);
    align-items: start;
  }

  .intro-card {
    padding: clamp(1.2rem, 2.4vw, 1.7rem);
    display: grid;
    gap: 0.8rem;
    align-content: start;
  }

  .block-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    position: relative;
    padding-left: 0.7rem;
  }

  .block-title::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.16em;
    bottom: 0.16em;
    width: 3px;
    border-radius: 999px;
    background: var(--brand);
  }

  .intro-paragraph {
    margin: 0;
    color: var(--text-soft);
    line-height: 1.85;
  }

  .focus-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.62rem;
  }

  .focus-list li {
    position: relative;
    padding-left: 1.3rem;
    color: var(--text-soft);
    line-height: 1.7;
  }

  .focus-list li::before {
    content: "";
    position: absolute;
    left: 0.2em;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand);
    opacity: 0.75;
  }

  .goal-band {
    padding: 1.15rem 1.4rem;
    border-left: 3px solid var(--brand);
    background: color-mix(in oklab, var(--brand-soft) 34%, var(--surface-1) 66%);
  }

  .goal-band p {
    margin: 0;
    color: var(--text);
    line-height: 1.85;
  }

  .about-section {
    display: grid;
    gap: var(--space-3);
  }

  .section-heading {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    position: relative;
    padding-left: 0.7rem;
  }

  .section-heading::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.16em;
    bottom: 0.16em;
    width: 3px;
    border-radius: 999px;
    background: var(--brand);
  }

  .empty-note {
    margin: 0;
    color: var(--text-soft);
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-3);
  }

  .showcase-card {
    padding: 1rem;
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .showcase-card .cover {
    width: 100%;
    border-radius: 10px;
    border: 1px solid var(--line);
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .showcase-card h3 {
    margin: 0;
    font-size: 1.02rem;
  }

  .showcase-card p {
    margin: 0;
    color: var(--text-soft);
    line-height: 1.7;
    font-size: 0.92rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    font-size: 0.86rem;
  }

  .links a {
    color: var(--brand);
  }

  .blog-panel {
    padding: clamp(1.2rem, 2.4vw, 1.7rem);
    display: grid;
    gap: var(--space-3);
  }

  .blog-lead {
    margin: 0;
    color: var(--text-soft);
    line-height: 1.85;
    max-width: 52em;
  }

  .topic-grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.55rem 1.2rem;
  }

  .topic-grid li {
    position: relative;
    padding-left: 1.2rem;
    color: var(--text-soft);
    line-height: 1.7;
    font-size: 0.94rem;
  }

  .topic-grid li::before {
    content: "";
    position: absolute;
    left: 0.15em;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand);
    opacity: 0.75;
  }

  .blog-hope {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .gaming-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
  }

  .game-group {
    padding: 1rem;
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .game-group h3 {
    margin: 0;
    font-size: 0.95rem;
  }

  .game-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .game-chip {
    font-size: 0.76rem;
  }

  .narrative {
    color: var(--text-soft);
  }

  @media (max-width: 760px) {
    .about-page {
      gap: var(--space-4);
    }
  }
</style>
