---
import ListLayout from "@/layouts/ListLayout.astro";
import siteConfig from "@/site.config";
import { fetchAllEntries, fetchTutorialEntries, makeTagItems } from "@/utils/query";
import { buildTutorialSeriesBuckets, toSeriesRouteKey } from "@/utils/tutorial-series";
import { formatDate } from "@/utils/date";
import { buildResponsiveImageSources } from "@/utils/image";
import ContentCover from "@/components/ContentCover.astro";

interface TutorialsPageConfig {
  title?: string;
  description?: string;
  overview?: {
    columns?: { xl?: number; lg?: number; md?: number };
    gap?: number;
    cardStyle?: "cover-top" | "cover-left" | "compact";
    coverAspectRatio?: string;
    showEntryCount?: boolean;
    showLastUpdated?: boolean;
    showCategory?: boolean;
    showDescription?: boolean;
  };
}

const [tutorials, allEntries] = await Promise.all([fetchTutorialEntries(), fetchAllEntries()]);
const tags = makeTagItems(allEntries);
const pageConfig = (siteConfig.pages.tutorials as TutorialsPageConfig | undefined) ?? {};
const overview = pageConfig.overview ?? {};

const columns = {
  xl: Number(overview.columns?.xl ?? 3),
  lg: Number(overview.columns?.lg ?? 2),
  md: Number(overview.columns?.md ?? 1)
};
const gap = Number(overview.gap ?? 16);
const coverAspectRatio = overview.coverAspectRatio ?? "16 / 9";
const showEntryCount = overview.showEntryCount ?? true;
const showLastUpdated = overview.showLastUpdated ?? true;
const showCategory = overview.showCategory ?? true;
const showDescription = overview.showDescription ?? true;

const seriesMap = buildTutorialSeriesBuckets(tutorials);

const seriesList = [...seriesMap.values()]
  .sort((a, b) => {
    if (a.order !== b.order) return a.order - b.order;
    if (b.latestAt !== a.latestAt) return b.latestAt - a.latestAt;
    return b.entries.length - a.entries.length;
  });
---

<ListLayout
  title={pageConfig.title ?? "专栏与系统教程"}
  description={pageConfig.description ?? "系统化沉淀的技术专栏与实战指南，涵盖音视频开发、计算机视觉、系统编程与全栈架构。"}
  stats={[
    { title: "专栏总数", value: seriesList.length },
    { title: "教程篇数", value: tutorials.length }
  ]}
  tags={tags}
>
  <div class="tutorials-page">
    <div
      class="series-grid"
      style={`--series-grid-gap:${gap}px;--series-col-xl:${columns.xl};--series-col-lg:${columns.lg};--series-col-md:${columns.md};--series-cover-ratio:${coverAspectRatio};`}
    >
      {
        seriesList.map((bucket) => {
          const href = `/tutorials/${encodeURIComponent(toSeriesRouteKey(bucket.key))}`;
          const metaParts = [];
          if (showEntryCount) metaParts.push(`${bucket.entries.length} 篇`);
          if (showLastUpdated) metaParts.push(`更新于 ${formatDate(new Date(bucket.latestAt), "YYYY-MM-DD")}`);
          const metaText = metaParts.join(" · ");
          const coverSources = buildResponsiveImageSources(bucket.cover, [320, 480, 640, 960], 640);
          return (
            <article class="surface series-card">
              <a class="series-cover" href={href} aria-label={bucket.label}>
                <ContentCover
                  title={bucket.label}
                  image={coverSources.src}
                  srcset={coverSources.srcset}
                  sizes="(max-width: 900px) calc(100vw - 64px), (max-width: 1200px) 38vw, 280px"
                  kindLabel="专栏"
                  topic={bucket.category}
                  loading="lazy"
                  fetchpriority="low"
                  variant="regular"
                />
                {showCategory && bucket.category && (
                  <span class="cover-category-badge">{bucket.category}</span>
                )}
              </a>

              <div class="series-body">
                <header class="series-head">
                  <h2 class="series-title">
                    <a href={href}>{bucket.label}</a>
                  </h2>
                </header>

                {showDescription && bucket.description && (
                  <p class="series-description">{bucket.description}</p>
                )}

                <footer class="series-foot">
                  {metaText && <span class="series-meta">{metaText}</span>}
                  <a href={href} class="series-enter-link">
                    阅读专栏 <span class="arrow" aria-hidden="true">→</span>
                  </a>
                </footer>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</ListLayout>

<style is:global>
  .tutorials-page {
    width: 100%;
  }

  .tutorials-page .series-grid {
    display: grid;
    grid-template-columns: repeat(var(--series-col-xl), minmax(0, 1fr));
    gap: var(--series-grid-gap);
  }

  .tutorials-page .series-card {
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in oklab, var(--line) 80%, transparent 20%);
    overflow: hidden;
    background: var(--surface-1);
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0;
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }

  .tutorials-page .series-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--brand) 45%, var(--line) 55%);
    box-shadow: 0 6px 20px color-mix(in oklab, var(--line) 35%, transparent 65%);
  }

  .tutorials-page .series-cover {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 145px;
    height: auto;
    flex: 0 0 auto; /* 保证在 Flex 列布局中绝对不会被压缩成一条细缝 */
    overflow: hidden;
    background: var(--surface-2);
    border-bottom: 1px solid color-mix(in oklab, var(--line) 75%, transparent 25%);
  }

  .tutorials-page .cover-category-badge {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    z-index: 4;
    font-size: 0.7rem;
    padding: 0.15rem 0.48rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-weight: 500;
    line-height: 1.3;
  }

  .tutorials-page .series-body {
    padding: 1.05rem 1.15rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 0.65rem;
  }

  .tutorials-page .series-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .tutorials-page .series-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .tutorials-page .series-title a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .tutorials-page .series-title a:hover {
    color: var(--brand);
  }

  .tutorials-page .series-description {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.86rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tutorials-page .series-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px dashed color-mix(in oklab, var(--line) 65%, transparent 35%);
  }

  .tutorials-page .series-meta {
    font-size: 0.74rem;
    color: var(--text-muted);
    font-family: var(--font-tech);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tutorials-page .series-enter-link {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--brand);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
    flex-shrink: 0;
    transition: gap 0.15s ease;
  }

  .tutorials-page .series-card:hover .series-enter-link .arrow {
    transform: translateX(2px);
  }

  .tutorials-page .arrow {
    transition: transform 0.15s ease;
  }

  @media (max-width: 1160px) {
    .tutorials-page .series-grid {
      grid-template-columns: repeat(var(--series-col-lg), minmax(0, 1fr));
    }
  }

  @media (max-width: 780px) {
    .tutorials-page .series-grid {
      grid-template-columns: repeat(var(--series-col-md), minmax(0, 1fr));
    }
  }
</style>
